---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { byDateDesc } from '../../lib/projects';
import { getCollection } from 'astro:content';

const published = await getCollection('projects', ({ data }) => !data.draft);
const projects = published
  .map((entry) => ({ slug: entry.slug, ...entry.data }))
  .sort(byDateDesc);
const [newestProject, ...restProjects] = projects;
---
<BaseLayout
  title="Projects, John Ng"
  description="Selected work by John Ng: extensions, platforms, and research tools, with full write-ups."
>
  <div class="intro-band">
    <div class="intro-inner">
      {/* No "Selected work" eyebrow above "Projects": one labelled the other. */}
      <h1>Projects</h1>
      <p class="lede">A running log of what I've built: extensions, platforms, research tools. I add full write-ups as I finish each one.</p>
    </div>
  </div>
  <div class="seam" style="--seam-from: var(--wash-featured); --seam-to: var(--color-bg);"></div>
  <div class="grid-wrap">
    {newestProject && (
      <div class="featured-row">
        <ProjectCard project={newestProject} showCover={true} featured={true} heading={2} />
      </div>
    )}
    {restProjects.length > 0 && (
      <div class="project-grid">
        {restProjects.map((project) => <ProjectCard project={project} showCover={true} heading={2} />)}
      </div>
    )}
  </div>
</BaseLayout>
<style>
  .intro-band {
    /* Per-route identity: this page owns L-orange, the same hue as its rail
       tick in Nav.astro. The wash is already the orange --wash-featured; the
       edge-tick below brings the rail's marker language into the header so the
       page and its nav marker read as one identity. */
    --hue: var(--piece-l);
    background: var(--wash-featured);
    /* No inline padding here — it belongs inside .intro-inner's 72rem box so
       the header lines up with .grid-wrap below, which also pads inside its
       own 72rem box. With the padding out here instead, the two containers
       centred against different available widths and the page title landed
       exactly --space-5 left of the first card. */
    padding: var(--space-8) 0 var(--space-7);
  }
  /* Shares .grid-wrap's 72rem container, not its own 42rem one. Both were
     centred but around different widths, so the page title sat a couple of
     hundred pixels right of the first card it introduced. The measure lives
     on .lede instead, where it belongs. */
  .intro-inner {
    position: relative;
    /* Paints above .seam (z-index: 1) so the blurred blend band washes over
       the band's background only, not over the header text itself. */
    z-index: 2;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--space-5);
  }
  /* Static "you're here" edge-tick (no hover/grow — a header marks the page,
     it isn't an interactive rail link), in the route hue.
     Anchored to the h1 rather than to the block, for two reasons: it now
     auto-sizes to the title instead of carrying a hardcoded 3.4rem height
     measured against a title-plus-eyebrow that no longer exists, and it hangs
     into the band's own gutter so the title itself lines up exactly with the
     first card below rather than sitting a tick's width right of it. The
     offset stays inside .intro-band's --space-5 padding at every width. */
  .intro-inner h1 {
    position: relative;
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: var(--track-display);
    margin: 0;
    text-wrap: balance;
  }
  .intro-inner h1::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-4));
    top: 0.12em;
    bottom: 0.12em;
    width: 4px;
    border-radius: 1px;
    background: var(--hue);
  }
  .intro-inner .lede {
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 62ch;
    color: var(--color-text-secondary);
    margin: var(--space-4) 0 0;
  }
  /* Same blur-band mechanism as index.astro's own .seam — one wash band
     fading to flat --color-bg before the grid, not a new pattern. */
  .seam {
    position: relative;
    z-index: 1;
    height: 6rem;
    margin-top: -3rem;
    margin-bottom: -3rem;
    background: linear-gradient(to bottom, var(--seam-from), var(--seam-to));
    filter: blur(32px);
    pointer-events: none;
  }
  .grid-wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-7) var(--space-5) var(--space-8);
  }
  .featured-row {
    margin-bottom: var(--space-6);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
  }
</style>
