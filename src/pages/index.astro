---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TetrisHero from '../components/TetrisHero.astro';
import { getCollection } from 'astro:content';
import { selectFeatured } from '../lib/projects';

const allProjects = await getCollection('projects');
const featured = selectFeatured(
  allProjects.map((p) => ({ slug: p.slug, ...p.data })),
  3
);
---
<BaseLayout title="John Ng">
  <section class="hero">
    <div class="hero-copy">
      <button class="nameplate" id="nameplate" type="button">
        <span class="ch j-piece">J</span><span class="ch o-piece">O</span><span class="ch">H</span><span class="ch">N</span><span class="ch sp">&nbsp;</span><span class="ch">N</span><span class="ch">G</span>
      </button>
      <p class="eyebrow">Software Engineer</p>
      <h1>Coding practical solutions for people. That's always been the point.</h1>
    </div>
    <TetrisHero />
  </section>

  <section class="bio">
    <div class="bio-frame">
      <img src="/headshot.jpg" alt="John Ng" width="759" height="759" />
    </div>
    <div class="bio-copy">
      <p class="eyebrow">College Park, MD — CS @ UMD</p>
      <h2>Hi, I'm John Ng.</h2>
      <p class="lede">I build software — mostly Java and Python, sometimes JS, React, and C.</p>
      <p class="detail">Five years in, I've mentored student coders from Brazil to Ukraine along the way.</p>
      <p class="detail">Next up: putting that experience toward software for education and public health.</p>
    </div>
  </section>

  <section class="featured">
    <h2>Featured projects</h2>
    <div class="project-grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</BaseLayout>
<style>
  .hero {
    position: relative;
    padding: var(--space-9) var(--space-5);
  }
  .hero-copy {
    max-width: 60ch;
  }
  @media (min-width: 769px) {
    .hero-copy {
      position: relative;
      z-index: 1;
      /* A plain percentage shrinks the copy column every time the window
         does, so it wraps far more aggressively on a narrower desktop
         window than it does at a wide/fullscreen one. Holding a fixed
         floor keeps the fullscreen wrap pattern as the window narrows,
         only yielding back to the percentage once the window is narrow
         enough that holding the floor would run text under the Tetris
         board. */
      max-width: max(23rem, 40%);
    }
  }
  .nameplate {
    font-family: 'Unbounded', sans-serif;
    font-weight: 800;
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    letter-spacing: -0.01em;
    line-height: 1;
    display: flex;
    gap: 3px;
    margin: 0 0 var(--space-3);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .nameplate:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 4px;
  }
  .nameplate .ch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-width: 1.05em;
    color: var(--cell, var(--color-text));
  }
  .nameplate .ch.sp {
    min-width: 0.4em;
  }
  /* Only J and O are colored — they're the only letters in "JOHN NG" that
     are also real tetromino letters (I/O/T/S/Z/J/L), each using that
     piece's own hue. Not "first letter of each word" — H/N/N/G stay
     neutral because none of them name a piece. */
  .nameplate .ch.j-piece {
    --cell: var(--tetris-j);
  }
  .nameplate .ch.o-piece {
    --cell: var(--tetris-o);
  }
  /* The flash overlay — a fixed white, not a token, since it's meant to
     read as a flash regardless of theme (unlike the ambient board's own
     --color-bg flash, which sits inside a grid of alternating cells this
     button doesn't have). Toggled by the "flashing" class from the script
     below, in lockstep with TetrisHero.astro's own flashRows() cadence. */
  .nameplate .ch:not(.sp)::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #ffffff;
    opacity: 0;
  }
  .nameplate .ch.flashing::before {
    opacity: 1;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }
  .hero-copy h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }
  .bio {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-9) var(--space-5);
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: var(--space-8);
    align-items: center;
    border-top: 1px solid var(--line);
  }
  .bio-frame {
    position: relative;
    justify-self: start;
    width: 100%;
    max-width: 22rem;
  }
  .bio-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(16px, 16px);
    background: var(--color-accent);
    border-radius: 63% 37% 54% 46% / 43% 65% 35% 57%;
    z-index: 0;
  }
  .bio-frame img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 63% 37% 54% 46% / 43% 65% 35% 57%;
  }
  .bio-copy .eyebrow {
    margin: 0 0 var(--space-4);
  }
  .bio-copy h2 {
    font-size: clamp(2.2rem, 4vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }
  .bio-copy .lede {
    font-size: 1.2rem;
    line-height: 1.5;
    max-width: 34ch;
    margin: 0 0 var(--space-5);
  }
  .bio-copy .detail {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 42ch;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }
  @media (max-width: 860px) {
    .bio {
      grid-template-columns: 1fr;
    }
    .bio-frame {
      justify-self: center;
      max-width: 16rem;
      margin-bottom: var(--space-4);
    }
    .bio-copy .lede,
    .bio-copy .detail {
      max-width: 100%;
    }
  }

  .featured {
    padding: 0 var(--space-5);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    padding-bottom: 4rem;
  }
</style>

<script>
  // Kept in sync with TetrisHero.astro's own flashRows() constants/pattern
  // (same class-toggle mechanism, same cadence) so the nameplate's flash
  // reads as the same motion language as the board's line-clear flash
  // rather than a separately-invented animation.
  const FLASH_CYCLES = 3;
  const FLASH_INTERVAL_MS = 90;

  const nameplateEl = document.getElementById('nameplate');
  if (nameplateEl) {
    const flashCells = Array.from(
      nameplateEl.querySelectorAll<HTMLElement>('.ch:not(.sp)')
    );
    let isFlashing = false;

    function flashNameplate(): void {
      if (isFlashing) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      isFlashing = true;
      let tick = 0;
      const step = () => {
        flashCells.forEach((el) => el.classList.toggle('flashing'));
        tick++;
        if (tick >= FLASH_CYCLES * 2) {
          flashCells.forEach((el) => el.classList.remove('flashing'));
          isFlashing = false;
          return;
        }
        window.setTimeout(step, FLASH_INTERVAL_MS);
      };
      step();
    }

    flashNameplate();
    nameplateEl.addEventListener('click', flashNameplate);
  }
</script>
