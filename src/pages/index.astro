---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TetrisHero from '../components/TetrisHero.astro';
import PieceMark from '../components/PieceMark.astro';
import { getCollection } from 'astro:content';
import { selectFeatured } from '../lib/projects';

const allProjects = await getCollection('projects');
const featured = selectFeatured(
  allProjects.map((p) => ({ slug: p.slug, ...p.data })),
  3
);

// Education well: 10 columns, 7 rows, rendered top→bottom. The top row is the
// final-semester line — filled except the I-piece's four landing cells; each
// locked row below it (one per completed semester) carries a single buried
// hole, because a *complete* line would already have cleared itself.
const WELL_COLS = 10;
const WELL_GAP = [3, 4, 5, 6]; // top row: the I-piece's landing columns
const WELL_HOLES = [1, 5, 8, 2, 7, 3]; // locked rows top→bottom: hole column per row
const WELL_ROWS = [
  Array.from({ length: WELL_COLS }, (_, c) => !WELL_GAP.includes(c)),
  ...WELL_HOLES.map((h) => Array.from({ length: WELL_COLS }, (_, c) => c !== h)),
];
---
<BaseLayout
  title="John Ng — Software Engineer"
  description="John Ng is a software engineer building extensions, platforms, and research tools. Selected projects, write-ups, and contact."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        name: 'John Ng',
        url: 'https://johnjng.com',
      },
      {
        '@type': 'Person',
        name: 'John Ng',
        url: 'https://johnjng.com',
        jobTitle: 'Computer Science Student',
        image: 'https://johnjng.com/headshot.jpg',
        sameAs: [
          'https://github.com/JohnN05',
          'https://www.linkedin.com/in/johnn05/',
        ],
      },
    ],
  })} />
  {/* `in` is authored here, not added by script: the hero is on screen at load
      by definition, and reveal is an on-ENTRY effect, so it must never animate
      in. The hidden state now lands before first paint, which is too early for
      any script to mark the hero resting in time — only markup gets there
      first. If a deliberate hero load-in is ever wanted, it needs its own
      mechanism; do not get it by deleting this class. */}
  <section class="hero in" data-scroll-section>
    <div class="hero-copy" data-depth="0.05">
      <button class="nameplate" id="nameplate" type="button" data-reveal aria-label="John Ng — replay name animation">
        <PieceMark layout="inline" reveals={true} trigger="load" />
      </button>
      <p class="eyebrow" data-reveal>Software Engineer</p>
      <h1 data-reveal>Building peace of mind, <span class="piece">one piece at a time.</span></h1>
    </div>
    <TetrisHero />
  </section>

  <div class="seam" style="--seam-from: var(--wash-hero); --seam-to: var(--wash-bio);"></div>

  <section class="bio" data-scroll-section>
    <div class="bio-inner">
      {/* Portrait as an O-piece dissolve. Server-rendered cells (no runtime
          createElement), so ordinary Astro scoping applies. The core is the
          photo clipped to square-minus-O; the four .blk cells slice the same
          photo (sprite: background-size 400% + per-cell position) and sit
          exactly over the notch, with a .back plate repainting the O quarter
          beneath them so fractional-pixel seams between the cells reveal
          photo, not the page wash. At rest — reduced motion, no JS — the whole
          thing reads as one clean square. It's a real <button> (keyboard users
          get the break/reassemble toggle pointer users always had), shipped
          `disabled`: the script below enables it only when it attaches its
          click handler (motion allowed), so reduced-motion/no-JS renders a
          genuinely inert photo instead of a focusable control that does
          nothing. Spans, not divs — button content must be phrasing content. */}
      <button class="bio-frame" type="button" disabled data-reveal data-depth="0.1" aria-label="Portrait of John Ng — activate to toggle the O-piece animation">
        <span class="core"></span>
        <span class="back"></span>
        <span class="blk o1"><span class="fill"></span><span class="flash"></span></span>
        <span class="blk o2"><span class="fill"></span><span class="flash"></span></span>
        <span class="blk o3"><span class="fill"></span><span class="flash"></span></span>
        <span class="blk o4"><span class="fill"></span><span class="flash"></span></span>
      </button>
      <div class="bio-copy" data-depth="0.03">
        <p class="eyebrow" data-reveal>College Park, MD — CS @ UMD · Secondary Ed & Asian Am Studies minors</p>
        <h2 data-reveal>Hi, I'm John Ng.</h2>
        <p class="lede" data-reveal>I build software people actually use, then teach the next person how to build it too.</p>
        <p class="detail" data-reveal>Chrome extension UMD students use every registration cycle. A summer turning a 270M-row bottleneck into a shipped platform at Capital Technology Group.</p>
      </div>
    </div>
  </section>

  <div class="seam" style="--seam-from: var(--wash-bio); --seam-to: var(--wash-featured);"></div>

  <section class="featured" data-scroll-section>
    <div class="featured-inner">
      <p class="eyebrow" data-reveal>Selected work</p>
      <h2 data-reveal>Featured projects</h2>
      <div class="project-grid" data-depth="0.08">
        {featured.map((p) => <ProjectCard project={p} showCover={true} />)}
      </div>
    </div>
  </section>

  <div class="seam" style="--seam-from: var(--wash-featured); --seam-to: var(--wash-education);"></div>

  {/* "One line left." The section's piece is the I-piece, and this is the one
      thing an I-piece is for: the well below holds six locked rows — one per
      completed semester, each with a single buried hole like a real mid-game
      stack (six *complete* lines would have cleared themselves) — and a top
      row missing exactly the I-piece's four cells. On entry the piece drops,
      the line flashes and clears, and the HUD's score tick lands and fades
      like a game popup. The facts
      (GPA, Dean's List, grad date) live in the HUD as real text, so the well
      itself stays decorative: role="img", no AT control, and under reduced
      motion or no JS it simply never plays — the static pre-clear state is
      the headline anyway. */}
  <section class="education" data-scroll-section>
    <div class="education-inner" data-depth="0.06">
      <p class="eyebrow" data-reveal>Education</p>
      <h2 data-reveal>One line left.</h2>
      <div class="edu-grid">
        <div class="edu-copy">
          <p class="lede" data-reveal>B.S. Computer Science at the University of Maryland, with minors in Secondary Education and Asian American Studies &mdash; graduating this December, three and a half years in.</p>
          <p class="detail" data-reveal>The education half isn't theoretical, and it isn't new: I taught 60+ students across Ukraine, Taiwan, and Brazil before I ever declared the minor. And yes, the coursework included game programming &mdash; this site was going to happen eventually.</p>
        </div>
        <div class="edu-game" data-reveal>
          <div class="well" role="img" aria-label="Tetris well with six locked rows, one per completed semester, and a single line left to clear">
            {WELL_ROWS.map((row, i) => (
              <div class:list={["row", { top: i === 0 }]}>
                {row.map((on) => <span class:list={["cell", { on }]}></span>)}
              </div>
            ))}
            <div class="ipiece" aria-hidden="true">
              <span class="cell ip"></span>
              <span class="cell ip"></span>
              <span class="cell ip"></span>
              <span class="cell ip"></span>
            </div>
          </div>
          <div class="hud">
            <div class="hud-row">
              <span class="hud-l">GPA</span>
              <span class="hud-v">3.89</span>
            </div>
            <div class="hud-row">
              <span class="hud-l">Dean's List</span>
              <span class="hud-v">6/6</span>
            </div>
            <div class="hud-row">
              <span class="hud-l">Graduating</span>
              <span class="hud-v">Dec &rsquo;26</span>
            </div>
            <p class="hud-score" data-score>Single +100</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="seam" style="--seam-from: var(--wash-education); --seam-to: var(--color-bg);"></div>
</BaseLayout>
<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    /* Leaves part of the next section visible below the fold on first load
       rather than exactly filling the viewport — a deliberate "there's more"
       cue, and the hook a future scroll-triggered reveal would key off of.
       90vh (a 10vh peek) on mobile; desktop tightens to 75vh via the
       min-width override near .seam below. */
    min-height: 90vh;
    padding: var(--space-10) var(--space-5);
    background: var(--wash-hero);
    scroll-snap-align: start;
  }
  .hero-copy {
    max-width: 60ch;
  }
  @media (min-width: 769px) {
    .hero-copy {
      position: relative;
      z-index: 1;
      /* A plain percentage shrinks the copy column every time the window
         does, so it wraps far more aggressively on a narrower desktop
         window than it does at a wide/fullscreen one. Holding a fixed
         floor keeps the fullscreen wrap pattern as the window narrows,
         only yielding back to the percentage once the window is narrow
         enough that holding the floor would run text under the Tetris
         board. */
      max-width: max(23rem, 40%);
    }
  }
  .nameplate {
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    display: inline-flex;
    margin: 0 0 var(--space-3);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: inherit;
  }
  .nameplate:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 6px;
    border-radius: 4px;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }
  .hero-copy h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }
  /* "one piece at a time" — the payoff clause and the only line on the site
     that names the Tetris metaphor in words (peace ↔ piece pun) — carries the
     cobalt accent so it reads as the emphasis. Mixed toward --color-text
     (70/30), same pattern as the education stat numbers below: raw --color-accent
     against the dark-mode --wash-hero measures ~2.1:1, short of WCAG AA's 3:1
     large-text floor; the mix lightens in dark mode (and darkens slightly in
     light mode) to clear it in both themes. */
  .hero-copy h1 .piece {
    color: color-mix(in srgb, var(--color-accent) 70%, var(--color-text));
  }
  .bio {
    display: flex;
    align-items: center;
    min-height: 90vh;
    padding: var(--space-10) var(--space-5);
    background: var(--wash-bio);
    scroll-snap-align: start;
  }
  .bio-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  /* O-piece dissolve. --img is the shared source every cell slices; the core is
     the photo clipped to the square minus the O notch (a bottom-left 2×2), so
     when the cells break off the notch shows the wash behind. Cells colour to
     --piece-o (gold, the bio section's own piece) when broken, and flash white
     on reassembly before resolving back to the photo. */
  .bio-frame {
    position: relative;
    display: block;
    justify-self: start;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 1 / 1;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    text-align: inherit;
    --img: url('/headshot.jpg');
  }
  /* Shipped disabled (inert photo) until the script arms the toggle under
     motion-allowed — no pointer affordance while it does nothing. */
  .bio-frame:disabled {
    cursor: default;
  }
  .bio-frame .core {
    position: absolute;
    inset: 0;
    border-radius: 3px;
    background-image: var(--img);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    /* The notch corner is nudged 1px into the O quarter (x 50%→50%-1px,
       y 50%→50%+1px) so the core paints a hair *under* the four cells that
       cover it at rest. Without the overlap, core's clipped edge and the
       cells' edges both antialias against transparency at the exact 50%
       seam, leaving a hairline of the wash showing through between the
       stationary core and the moving pieces. The strip is the same photo
       the covering cells already show, so the overlap is invisible at rest. */
    -webkit-clip-path: polygon(0 0, 100% 0, 100% 100%, calc(50% - 1px) 100%, calc(50% - 1px) calc(50% + 1px), 0 calc(50% + 1px));
    clip-path: polygon(0 0, 100% 0, 100% 100%, calc(50% - 1px) 100%, calc(50% - 1px) calc(50% + 1px), 0 calc(50% + 1px));
  }
  /* Backing plate under the four O cells: repaints exactly the O quarter of
     the photo (same sprite math as the cells — 200% on a 50% box == 400% on
     a 25% box, anchored at the frame's top-left). The cells are 25% boxes on
     fractional-percentage positions, and `will-change` promotes each to its
     own composited layer, so wherever the frame size doesn't divide evenly
     the internal seams (the cross at 25%/75%) antialias against whatever is
     beneath. The core's notch is clipped away there, so what showed through
     was the page wash: a faint 1px cross across the portrait. With the plate,
     the seams reveal the same photo pixels the cells already show — invisible
     at any size. It stays hidden through the whole break/reassemble cycle
     (broken *or* coloured/flashing) and only fades back in once the animation
     has fully resolved to the resting photo — appearing mid-flight, it read
     as a stray photo square sliding under the still-moving pieces. */
  .bio-frame .back {
    position: absolute;
    left: 0;
    top: 50%;
    width: 50%;
    height: 50%;
    background-image: var(--img);
    background-repeat: no-repeat;
    background-size: 200% 200%;
    background-position: 0% 100%;
    transition: opacity 0.28s ease;
  }
  .bio-frame.broken .back,
  .bio-frame.colored .back,
  .bio-frame.flashing .back {
    opacity: 0;
  }
  .bio-frame .blk {
    position: absolute;
    width: 25%;
    height: 25%;
    background-image: var(--img);
    background-repeat: no-repeat;
    background-size: 400% 400%;
    /* Break travel is set on the individual translate/rotate properties (not
       transform) so `transform` stays free for the hover float below — the two
       compose in the render pipeline instead of one clobbering the other. */
    transition: translate 0.55s cubic-bezier(0.2, 0.75, 0.25, 1),
                rotate 0.55s cubic-bezier(0.2, 0.75, 0.25, 1),
                box-shadow 0.4s ease;
    will-change: translate, transform;
  }
  .bio-frame .fill,
  .bio-frame .flash {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .bio-frame .fill {
    background: var(--piece-o);
    opacity: 0;
    transition: opacity 0.28s ease;
  }
  .bio-frame .flash {
    background: #fff;
    opacity: 0;
  }
  /* O cells: a 2×2 block in the bottom-left quarter (cols 0-1, rows 2-3). */
  .bio-frame .o1 { left: 0;   top: 50%; background-position: 0%      66.667%; }
  .bio-frame .o2 { left: 25%; top: 50%; background-position: 33.333% 66.667%; }
  .bio-frame .o3 { left: 0;   top: 75%; background-position: 0%      100%; }
  .bio-frame .o4 { left: 25%; top: 75%; background-position: 33.333% 100%; }
  .bio-frame.broken .blk {
    border-radius: 2px;
    box-shadow: 0 6px 18px rgba(15, 30, 61, 0.22);
  }
  .bio-frame.broken .o1 { translate: -64% -22%; rotate: -9deg; }
  .bio-frame.broken .o2 { translate: -30% -46%; rotate: 6deg; }
  .bio-frame.broken .o3 { translate: -72% 30%; rotate: 7deg; }
  .bio-frame.broken .o4 { translate: -26% 40%; rotate: -6deg; }
  @media (max-width: 860px) {
    /* The desktop break sends o2 up-left across the portrait's left cheek —
       fine at 22rem where the face sits high in the crop, but at phone sizes
       the face fills the frame and the piece covers it. Mobile sends both
       upper cells down/left of the notch instead, keeping the face clear
       (and within the viewport: the gutter beside the centered 16rem frame
       is ~67px at 390px wide). */
    .bio-frame.broken .o1 { translate: -72% -8%; }
    .bio-frame.broken .o2 { translate: -40% 42%; }
    .bio-frame.broken .o3 { translate: -80% 26%; }
    .bio-frame.broken .o4 { translate: -30% 48%; }
  }
  .bio-frame.colored .fill { opacity: 1; }
  .bio-frame.flashing .flash { opacity: 0.92; }
  /* Hovering the broken portrait signals it's clickable (toggles back whole):
     a white glow ring fades up on each floating piece, and they drift on a
     slow, phase-offset float so they don't bob in unison. Hover-only and
     hover-capable-devices-only — touch has no idle-hover state to get stuck in;
     those visitors still tap to reassemble, just without the cue. */
  @media (hover: hover) {
    .bio-frame.broken:hover .blk {
      box-shadow: 0 6px 18px rgba(15, 30, 61, 0.22),
                  0 0 0 1px rgba(255, 255, 255, 0.55),
                  0 0 12px 2px rgba(255, 255, 255, 0.45);
      animation: bio-piece-float 3.4s ease-in-out infinite;
    }
    .bio-frame.broken:hover .o2 { animation-delay: -0.8s; }
    .bio-frame.broken:hover .o3 { animation-delay: -1.6s; }
    .bio-frame.broken:hover .o4 { animation-delay: -2.4s; }
  }
  @keyframes bio-piece-float {
    50% { transform: translateY(-3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    /* Belt-and-suspenders: the script never attaches under reduced motion, so
       these classes are never added — but if they were, the portrait still
       stays a whole, un-coloured photo. */
    .bio-frame .blk { transition: none; animation: none; }
    .bio-frame.broken .blk { translate: 0; rotate: 0; box-shadow: none; }
    .bio-frame.broken:hover .blk { animation: none; box-shadow: none; }
    .bio-frame.broken .back,
    .bio-frame.colored .back,
    .bio-frame.flashing .back { opacity: 1; }
    .bio-frame.colored .fill { opacity: 0; }
  }
  .bio-copy .eyebrow {
    margin: 0 0 var(--space-4);
  }
  .bio-copy h2 {
    font-size: clamp(1.7rem, 2.4vw, 2rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }
  .bio-copy .lede {
    font-size: 1.2rem;
    line-height: 1.5;
    max-width: 34ch;
    margin: 0 0 var(--space-5);
  }
  .bio-copy .detail {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 42ch;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }
  @media (max-width: 860px) {
    .bio-inner {
      grid-template-columns: 1fr;
    }
    .bio-frame {
      justify-self: center;
      max-width: 16rem;
      margin-bottom: var(--space-4);
    }
    .bio-copy .lede,
    .bio-copy .detail {
      max-width: 100%;
    }
  }

  .featured {
    display: flex;
    align-items: center;
    min-height: 90vh;
    padding: var(--space-10) var(--space-5);
    background: var(--wash-featured);
    scroll-snap-align: start;
  }
  .featured-inner {
    width: 100%;
  }
  .featured-inner .eyebrow {
    margin: 0 0 var(--space-4);
  }
  /* Matches teaching's h2 scale (both are section headers introducing a grid
     of content, not bio's smaller conversational greeting) — previously
     unsized, so this h2 fell back to the browser default (~1.5em) and read
     noticeably smaller than every sibling Home section heading. */
  .featured-inner h2 {
    font-size: clamp(2rem, 3.6vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-6);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .education {
    display: flex;
    align-items: center;
    min-height: 90vh;
    padding: var(--space-10) var(--space-5);
    background: var(--wash-education);
    scroll-snap-align: start;
  }
  .education-inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  .education .eyebrow {
    margin: 0 0 var(--space-4);
  }
  .education h2 {
    font-size: clamp(2rem, 3.6vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-6);
    max-width: 28ch;
  }

  .edu-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-8);
    align-items: center;
  }
  .edu-copy .lede {
    font-size: 1.2rem;
    line-height: 1.5;
    max-width: 38ch;
    margin: 0 0 var(--space-5);
  }
  .edu-copy .detail {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 42ch;
    color: var(--color-text-secondary);
    margin: 0;
  }
  .edu-game {
    display: flex;
    align-items: end;
    gap: var(--space-5);
  }

  /* The well. Cells are server-rendered (Astro template loop, no runtime
     createElement) so ordinary Astro scoping applies. Locked cells are a
     single neutral tone with a classic beveled-block inset; the teal I-piece
     is the only color in the frame — the focal point, and this section's
     assigned piece finally doing the thing I-pieces do. */
  .well {
    --cell: clamp(1rem, 1.8vw, 1.35rem);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: fit-content;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden; /* clips the raised I-piece before it drops */
  }
  .well .row {
    display: flex;
    gap: 2px;
  }
  .well .cell {
    width: var(--cell);
    height: var(--cell);
    border-radius: 2px;
  }
  .well .cell.on {
    background: color-mix(in srgb, var(--color-text) 30%, transparent);
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.22),
                inset -1px -1px 0 rgba(0, 0, 0, 0.18);
    transition: opacity 0.3s ease, scale 0.3s ease;
  }
  /* The I-piece sits absolutely over the top row's 4-wide gap (column 3, in
     cell+gap units), raised fully above the well and clipped by its overflow.
     Markup ships in this raised state — the static "one line left" image —
     and .play transitions it down into the gap with a gravity ease-in. */
  .ipiece {
    position: absolute;
    top: var(--space-3);
    left: calc(var(--space-3) + 3 * (var(--cell) + 2px));
    display: flex;
    gap: 2px;
    translate: 0 calc(-1 * (var(--cell) + var(--space-3) + 12px));
    transition: translate 0.48s cubic-bezier(0.55, 0, 0.85, 0.36),
                opacity 0.3s ease, scale 0.3s ease;
  }
  .well.play .ipiece {
    translate: 0 0;
  }
  .ipiece .cell {
    background: var(--piece-i);
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.35),
                inset -1px -1px 0 rgba(0, 0, 0, 0.22);
  }
  /* Same flash cadence as the bio reassembly: a class toggle loop in the
     script, no @keyframes to restart — the CSS is just the lit state. */
  .well.flashing .row.top .cell.on,
  .well.flashing .ipiece .cell {
    background: #fff;
  }
  /* Cleared: the top line (locked cells + the piece that completed it) fades
     and shrinks out. The rows below don't move — nothing sits above the
     cleared line, so gravity has nothing to do, and the empty top row reads
     as headroom. */
  .well.cleared .row.top .cell,
  .well.cleared .ipiece {
    opacity: 0;
    scale: 0.5;
  }

  /* HUD — the facts as a Tetris side panel. Mono labels/values instead of
     the retired stats grid, so the section stops being a third
     big-number block in a row; the game framing is carried by the box,
     not by forcing game labels onto real data. */
  .hud {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 11rem;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .hud-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }
  .hud-l {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .hud-v {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }
  /* Lands only after the clear, then fades back out like a game popup (the
     script toggles .in) — one line is a single, not a Tetris. Secondary text
     color, same convention as the retired stat-chip: --tetris-i at 0.72rem
     wouldn't clear WCAG AA's 4.5:1. */
  .hud-score {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: var(--space-1) 0 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .hud-score.in {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 860px) {
    .edu-grid {
      grid-template-columns: 1fr;
    }
    .edu-copy .lede,
    .edu-copy .detail {
      max-width: 100%;
    }
    .edu-game {
      justify-content: center;
      flex-wrap: wrap;
    }
  }

  /* Blend zone between two adjacent sections' wash colors — a flat
     color-mix boundary reads as a hard seam; a blurred gradient band
     straddling it reads as one continuous surface. Needs position:relative
     for z-index to take effect, which is what lets it paint over both
     neighboring sections despite sitting between them in source order —
     sections themselves stay position:static (flex doesn't change that),
     which always paints below positioned+z-index content regardless of DOM
     order. The last instance (education → --color-bg) fades the wash back
     out before Footer.astro, which stays plain on every route and has no
     idea this wash system exists. */
  .seam {
    position: relative;
    z-index: 1;
    height: 10rem;
    margin-top: -5rem;
    margin-bottom: -5rem;
    background: linear-gradient(to bottom, var(--seam-from), var(--seam-to));
    filter: blur(40px);
    pointer-events: none;
  }
  /* Desktop tightening: at desktop window heights the mobile pacing left a
     dead band of plain wash between one section's content and the next —
     roughly 40% of a ~900px-tall window at the worst mid-scroll stops.
     Sections shrink 90vh → 75vh (the peek of the next section grows from
     10vh to 25vh, which reads as a stronger "there's more" rather than as
     looseness) and the blend bands 10rem → 6rem. Mobile keeps the roomier
     values: at phone heights the sections are content-filled, so there is
     no void to remove. The reveal threshold in the script below rises in
     step — see REVEAL_THRESHOLD. */
  @media (min-width: 769px) {
    .hero, .bio, .featured, .education {
      min-height: 75vh;
    }
    .seam {
      height: 6rem;
      margin-top: -3rem;
      margin-bottom: -3rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero, .bio, .featured, .education {
      transition: background-color 0.15s ease;
    }
  }
</style>

<script>
  const REVEAL_STAGGER_MS = 110;
  // A beat after the section is judged entered, before the first child moves.
  const REVEAL_LEAD_IN_MS = 160;
  // How far into the section the reveal starts. Raising this delays the start
  // in scroll distance rather than in time, which is the other half of "later".
  // Must clear the largest at-rest peek of a not-yet-entered section: on
  // desktop the 75vh sections leave a 25vh peek, i.e. 33% of the next section
  // is already visible at a snap stop — a threshold at or below that would
  // fire the reveal before the visitor scrolls at all. 0.35 sits just above
  // it; mobile's 10vh-of-90vh peek (11%) is comfortably below.
  const REVEAL_THRESHOLD = 0.35;

  // Same reduced-motion convention as the Tetris ambient loop: check once, and
  // if motion is reduced simply never attach. The hidden state is gated on
  // data-motion, which BaseLayout.astro's inline head script sets before first
  // paint (and never sets under reduced motion), so content renders normally
  // here regardless.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-scroll-section]')
    );

    sections.forEach((section) => {
      const items = Array.from(
        section.querySelectorAll<HTMLElement>('[data-reveal]')
      );
      items.forEach((el, i) => {
        el.style.transitionDelay = `${REVEAL_LEAD_IN_MS + i * REVEAL_STAGGER_MS}ms`;
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('in');
          // Fires once per section per page load — no replay on re-entry.
          observer.unobserve(entry.target);
        });
      },
      { threshold: REVEAL_THRESHOLD }
    );

    // The hero ships with `in` already on it (see the markup) and is done;
    // observing it would only re-add a class it carries. Every other section
    // is governed solely by the threshold above — an earlier version also
    // pre-marked any section merely touching the viewport, which disagreed
    // with that threshold: the peek leaves part of the next section visible
    // at rest (11% mobile, 33% desktop), enough to be pre-marked but — by
    // construction, see REVEAL_THRESHOLD — never enough to trip the observer,
    // so a pre-marked section's reveal would silently never play.
    sections
      .filter((section) => !section.classList.contains('in'))
      .forEach((section) => observer.observe(section));
  }
</script>

<script>
  import { parallaxShift } from '../lib/parallax';

  const PARALLAX_MIN_WIDTH_PX = 769;
  const RESIZE_DEBOUNCE_MS = 150;

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // The width gate is per-frame, not once at load: a one-time matchMedia()
    // check meant a desktop→narrow shrink kept translating the stacked mobile
    // layout forever, and a narrow→desktop widen (a rotated tablet) never got
    // parallax at all. The MediaQueryList's .matches live-updates, so crossing
    // the breakpoint mid-session now enables/disables cleanly.
    const wide = matchMedia(`(min-width: ${PARALLAX_MIN_WIDTH_PX}px)`);
    const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-depth]'));
    const sectionTops = new Map<HTMLElement, number>();
    const visible = new Set<HTMLElement>();

    function hostOf(el: HTMLElement): HTMLElement | null {
      return el.closest<HTMLElement>('[data-scroll-section]');
    }

    // offsetTop forces a synchronous layout, so it is read here and on resize —
    // never inside the scroll handler. Same reasoning as TetrisHero.astro's
    // setupAmbientBoard().
    function refreshTops(): void {
      sectionTops.clear();
      document
        .querySelectorAll<HTMLElement>('[data-scroll-section]')
        .forEach((section) => sectionTops.set(section, section.offsetTop));
    }

    function applyParallax(): void {
      if (!wide.matches) {
        // Clear any offset written while wide, or a rotate back to portrait
        // leaves the mobile layout frozen mid-drift.
        for (const el of layers) el.style.removeProperty('--parallax-y');
        return;
      }
      const scrollY = window.scrollY;
      for (const el of layers) {
        const host = hostOf(el);
        if (!host || !visible.has(host)) continue;
        const top = sectionTops.get(host);
        if (top === undefined) continue;
        const shift = parallaxShift(scrollY, top, Number(el.dataset.depth));
        el.style.setProperty('--parallax-y', `${shift.toFixed(2)}px`);
      }
    }

    // Off-screen sections cost nothing: their layers are skipped entirely
    // rather than transformed where nobody can see them.
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const section = entry.target as HTMLElement;
        if (entry.isIntersecting) visible.add(section);
        else visible.delete(section);
      });
      applyParallax();
    });
    document
      .querySelectorAll<HTMLElement>('[data-scroll-section]')
      .forEach((section) => observer.observe(section));

    let queued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          applyParallax();
        });
      },
      { passive: true }
    );

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        refreshTops();
        applyParallax();
      }, RESIZE_DEBOUNCE_MS);
    });

    refreshTops();
    applyParallax();
  }
</script>

<script>
  // Education well: the final-semester line clear. The markup ships the
  // "one line left" state (piece raised, gap open), so reduced motion and
  // no-JS render that static image with nothing to do here; only when motion
  // is allowed do we play the drop. Fires once per page load, like the reveal
  // and the bio dissolve. Timing: a hold to let the section reveal settle,
  // the drop (matches the .ipiece transition), a lock beat, then the same
  // flash cadence as the bio reassembly, the clear, and the HUD score tick —
  // a game popup that lands, holds, and fades back out.
  const WELL_HOLD_MS = 700;
  const WELL_DROP_MS = 480;
  const WELL_LOCK_MS = 120;
  const WELL_FLASH_CYCLES = 3;
  const WELL_FLASH_MS = 90;
  // The score tick is a game popup, not a stat: it lands after the clear,
  // holds long enough to read, then fades back out like a real line-clear
  // score would — leaving it parked under the HUD rows read as a fourth fact.
  const WELL_SCORE_IN_MS = 250;
  const WELL_SCORE_HOLD_MS = 1600;

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const well = document.querySelector<HTMLElement>('.well');
    if (well) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.unobserve(entry.target);
            setTimeout(() => {
              well.classList.add('play'); // piece drops into the gap
              setTimeout(() => {
                let n = 0;
                const tick = () => {
                  well.classList.toggle('flashing');
                  n += 1;
                  if (n < WELL_FLASH_CYCLES * 2) {
                    setTimeout(tick, WELL_FLASH_MS);
                  } else {
                    well.classList.remove('flashing');
                    well.classList.add('cleared');
                    const score = well
                      .closest('.edu-game')
                      ?.querySelector<HTMLElement>('[data-score]');
                    if (score) {
                      setTimeout(() => {
                        score.classList.add('in');
                        setTimeout(
                          () => score.classList.remove('in'),
                          WELL_SCORE_HOLD_MS
                        );
                      }, WELL_SCORE_IN_MS);
                    }
                  }
                };
                tick();
              }, WELL_DROP_MS + WELL_LOCK_MS);
            }, WELL_HOLD_MS);
          });
        },
        { threshold: 0.4 }
      );
      observer.observe(well);
    }
  }
</script>

<script>
  // Bio portrait O-piece dissolve. On entry the photo holds whole for a beat,
  // then an O tetromino (a bottom-left 2×2 block) breaks off, the cells colour
  // to the section's gold, and the notch reveals the wash. Clicking toggles; on
  // reassembly the cells fly home and flash white before resolving to the photo.
  // Decorative — the resting whole photo needs no JS, so under reduced motion (or
  // no JS at all) this never attaches and the portrait renders as a clean square.
  const HOLD_MS = 650; // whole beat before the piece breaks off on entry
  const HOME_MS = 560; // time for scattered cells to fly back home (matches CSS)
  const FLASH_CYCLES = 3;
  const FLASH_MS = 90;

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const frame = document.querySelector<HTMLButtonElement>('.bio-frame');
    if (frame) {
      // The markup ships disabled (an inert whole photo for reduced motion /
      // no-JS); reaching this point means the toggle will actually work, so
      // arm the control before anyone can meet it half-enabled.
      frame.disabled = false;
      let busy = false;

      const breakApart = () => {
        frame.classList.add('broken');
        // Colour in a beat after the break starts, so the cells read as photo
        // first and gold second rather than snapping straight to solid.
        setTimeout(() => frame.classList.add('colored'), 120);
      };

      const assemble = () => {
        busy = true;
        frame.classList.remove('broken'); // cells fly home, still gold
        setTimeout(() => {
          // Same flash cadence as the board's flashRows(): a class toggle loop,
          // no CSS @keyframes to restart. Once done, drop the colour to reveal
          // the photo underneath.
          let n = 0;
          const tick = () => {
            frame.classList.toggle('flashing');
            n += 1;
            if (n < FLASH_CYCLES * 2) {
              setTimeout(tick, FLASH_MS);
            } else {
              frame.classList.remove('flashing', 'colored');
              busy = false;
            }
          };
          tick();
        }, HOME_MS);
      };

      frame.addEventListener('click', () => {
        if (busy) return; // ignore clicks mid-reassembly
        if (frame.classList.contains('broken')) assemble();
        else breakApart();
      });

      // Break off once, a beat after the section is judged entered.
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            setTimeout(breakApart, HOLD_MS);
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.4 }
      );
      observer.observe(frame);
    }
  }
</script>
