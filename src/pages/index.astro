---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TetrisHero from '../components/TetrisHero.astro';
import PieceMark from '../components/PieceMark.astro';
import { getCollection } from 'astro:content';
import { selectFeatured } from '../lib/projects';

const allProjects = await getCollection('projects');
const featured = selectFeatured(
  allProjects.map((p) => ({ slug: p.slug, ...p.data })),
  3
);
---
<BaseLayout title="John Ng">
  {/* `in` is authored here, not added by script: the hero is on screen at load
      by definition, and reveal is an on-ENTRY effect, so it must never animate
      in. The hidden state now lands before first paint, which is too early for
      any script to mark the hero resting in time — only markup gets there
      first. If a deliberate hero load-in is ever wanted, it needs its own
      mechanism; do not get it by deleting this class. */}
  <section class="hero in" data-scroll-section>
    <div class="hero-copy" data-depth="0.05">
      <button class="nameplate" id="nameplate" type="button" data-reveal>
        <PieceMark layout="inline" reveals={true} trigger="load" />
      </button>
      <p class="eyebrow" data-reveal>Software Engineer</p>
      <h1 data-reveal>Coding practical solutions for people. That's always been the point.</h1>
    </div>
    <TetrisHero />
  </section>

  <div class="seam" style="--seam-from: var(--wash-hero); --seam-to: var(--wash-bio);"></div>

  <section class="bio" data-scroll-section>
    <div class="bio-inner">
      <div class="bio-frame" data-reveal data-depth="0.1">
        <img src="/headshot.jpg" alt="John Ng" width="759" height="759" />
      </div>
      <div class="bio-copy" data-depth="0.03">
        <p class="eyebrow" data-reveal>College Park, MD — CS + Secondary Ed @ UMD</p>
        <h2 data-reveal>Hi, I'm John Ng.</h2>
        <p class="lede" data-reveal>I build software people actually use, then teach the next person how to build it too.</p>
        <p class="detail" data-reveal>Chrome extension UMD students use every registration cycle. A summer turning a 270M-row bottleneck into a shipped platform at Capital Technology Group.</p>
      </div>
    </div>
  </section>

  <div class="seam" style="--seam-from: var(--wash-bio); --seam-to: var(--wash-featured);"></div>

  <section class="featured" data-scroll-section>
    <div class="featured-inner">
      <h2 data-reveal>Featured projects</h2>
      <div class="project-grid" data-depth="0.08">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <div class="seam" style="--seam-from: var(--wash-featured); --seam-to: var(--wash-teaching);"></div>

  <section class="teaching" data-scroll-section>
    <div class="teaching-inner" data-depth="0.06">
      <p class="eyebrow" data-reveal>Teaching</p>
      <h2 data-reveal>I teach as much as I build.</h2>
      <p class="detail" data-reveal>Nobel Explorers ML/CV curriculum for 60+ students across Brazil, Ukraine, and Taiwan &mdash; now the same pattern running UMD's Chinese Student Association officer corps.</p>
    </div>
  </section>

  <div class="seam" style="--seam-from: var(--wash-teaching); --seam-to: var(--color-bg);"></div>
</BaseLayout>
<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    /* Leaves --peek (10vh) of the next section visible below the fold on
       first load rather than exactly filling the viewport — a deliberate
       "there's more" cue, and the hook a future scroll-triggered reveal
       would key off of. */
    min-height: 90vh;
    padding: var(--space-10) var(--space-5);
    background: var(--wash-hero);
    scroll-snap-align: start;
  }
  .hero-copy {
    max-width: 60ch;
  }
  @media (min-width: 769px) {
    .hero-copy {
      position: relative;
      z-index: 1;
      /* A plain percentage shrinks the copy column every time the window
         does, so it wraps far more aggressively on a narrower desktop
         window than it does at a wide/fullscreen one. Holding a fixed
         floor keeps the fullscreen wrap pattern as the window narrows,
         only yielding back to the percentage once the window is narrow
         enough that holding the floor would run text under the Tetris
         board. */
      max-width: max(23rem, 40%);
    }
  }
  .nameplate {
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    display: inline-flex;
    margin: 0 0 var(--space-3);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: inherit;
  }
  .nameplate:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 4px;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }
  .hero-copy h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }
  .bio {
    display: flex;
    align-items: center;
    min-height: 90vh;
    padding: var(--space-10) var(--space-5);
    background: var(--wash-bio);
    scroll-snap-align: start;
  }
  .bio-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  .bio-frame {
    position: relative;
    justify-self: start;
    width: 100%;
    max-width: 22rem;
  }
  .bio-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 20px;
  }
  .bio-copy .eyebrow {
    margin: 0 0 var(--space-4);
  }
  .bio-copy h2 {
    font-size: clamp(1.7rem, 2.4vw, 2rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }
  .bio-copy .lede {
    font-size: 1.2rem;
    line-height: 1.5;
    max-width: 34ch;
    margin: 0 0 var(--space-5);
  }
  .bio-copy .detail {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 42ch;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }
  @media (max-width: 860px) {
    .bio-inner {
      grid-template-columns: 1fr;
    }
    .bio-frame {
      justify-self: center;
      max-width: 16rem;
      margin-bottom: var(--space-4);
    }
    .bio-copy .lede,
    .bio-copy .detail {
      max-width: 100%;
    }
  }

  .featured {
    display: flex;
    align-items: center;
    min-height: 90vh;
    padding: var(--space-10) var(--space-5);
    background: var(--wash-featured);
    scroll-snap-align: start;
  }
  .featured-inner {
    width: 100%;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .teaching {
    display: flex;
    align-items: center;
    min-height: 90vh;
    padding: var(--space-10) var(--space-5);
    background: var(--wash-teaching);
    scroll-snap-align: start;
  }
  .teaching-inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  .teaching .eyebrow {
    margin: 0 0 var(--space-4);
  }
  .teaching h2 {
    font-size: clamp(2rem, 3.6vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-5);
    max-width: 20ch;
  }
  .teaching .detail {
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 56ch;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }

  /* Blend zone between two adjacent sections' wash colors — a flat
     color-mix boundary reads as a hard seam; a blurred gradient band
     straddling it reads as one continuous surface. Needs position:relative
     for z-index to take effect, which is what lets it paint over both
     neighboring sections despite sitting between them in source order —
     sections themselves stay position:static (flex doesn't change that),
     which always paints below positioned+z-index content regardless of DOM
     order. The last instance (teaching → --color-bg) fades the wash back
     out before Footer.astro, which stays plain on every route and has no
     idea this wash system exists. */
  .seam {
    position: relative;
    z-index: 1;
    height: 10rem;
    margin-top: -5rem;
    margin-bottom: -5rem;
    background: linear-gradient(to bottom, var(--seam-from), var(--seam-to));
    filter: blur(40px);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero, .bio, .featured, .teaching {
      transition: background-color 0.15s ease;
    }
  }
</style>

<script>
  const REVEAL_STAGGER_MS = 110;
  // A beat after the section is judged entered, before the first child moves.
  const REVEAL_LEAD_IN_MS = 160;
  // How far into the section the reveal starts. Raising this delays the start
  // in scroll distance rather than in time, which is the other half of "later".
  const REVEAL_THRESHOLD = 0.25;

  // Same reduced-motion convention as the Tetris ambient loop: check once, and
  // if motion is reduced simply never attach. The hidden state is gated on
  // data-motion, which BaseLayout.astro's inline head script sets before first
  // paint (and never sets under reduced motion), so content renders normally
  // here regardless.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-scroll-section]')
    );

    sections.forEach((section) => {
      const items = Array.from(
        section.querySelectorAll<HTMLElement>('[data-reveal]')
      );
      items.forEach((el, i) => {
        el.style.transitionDelay = `${REVEAL_LEAD_IN_MS + i * REVEAL_STAGGER_MS}ms`;
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('in');
          // Fires once per section per page load — no replay on re-entry.
          observer.unobserve(entry.target);
        });
      },
      { threshold: REVEAL_THRESHOLD }
    );

    // The hero ships with `in` already on it (see the markup) and is done;
    // observing it would only re-add a class it carries. Every other section
    // is governed solely by the threshold above — an earlier version also
    // pre-marked any section merely touching the viewport, which disagreed
    // with that threshold: the deliberate ~10vh peek left bio 11.1% visible at
    // 1920x1080, enough to be pre-marked but not enough to trip the observer,
    // so bio's reveal silently never played on tall viewports.
    sections
      .filter((section) => !section.classList.contains('in'))
      .forEach((section) => observer.observe(section));
  }
</script>

<script>
  import { parallaxShift } from '../lib/parallax';

  const PARALLAX_MIN_WIDTH_PX = 769;
  const RESIZE_DEBOUNCE_MS = 150;

  if (
    matchMedia(`(min-width: ${PARALLAX_MIN_WIDTH_PX}px)`).matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-depth]'));
    const sectionTops = new Map<HTMLElement, number>();
    const visible = new Set<HTMLElement>();

    function hostOf(el: HTMLElement): HTMLElement | null {
      return el.closest<HTMLElement>('[data-scroll-section]');
    }

    // offsetTop forces a synchronous layout, so it is read here and on resize —
    // never inside the scroll handler. Same reasoning as TetrisHero.astro's
    // setupAmbientBoard().
    function refreshTops(): void {
      sectionTops.clear();
      document
        .querySelectorAll<HTMLElement>('[data-scroll-section]')
        .forEach((section) => sectionTops.set(section, section.offsetTop));
    }

    function applyParallax(): void {
      const scrollY = window.scrollY;
      for (const el of layers) {
        const host = hostOf(el);
        if (!host || !visible.has(host)) continue;
        const top = sectionTops.get(host);
        if (top === undefined) continue;
        const shift = parallaxShift(scrollY, top, Number(el.dataset.depth));
        el.style.setProperty('--parallax-y', `${shift.toFixed(2)}px`);
      }
    }

    // Off-screen sections cost nothing: their layers are skipped entirely
    // rather than transformed where nobody can see them.
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const section = entry.target as HTMLElement;
        if (entry.isIntersecting) visible.add(section);
        else visible.delete(section);
      });
      applyParallax();
    });
    document
      .querySelectorAll<HTMLElement>('[data-scroll-section]')
      .forEach((section) => observer.observe(section));

    let queued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          applyParallax();
        });
      },
      { passive: true }
    );

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        refreshTops();
        applyParallax();
      }, RESIZE_DEBOUNCE_MS);
    });

    refreshTops();
    applyParallax();
  }
</script>
