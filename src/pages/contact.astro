---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout title="Contact — John Ng">
  <div class="contact-band" id="contact-band">
    {/* Ambient backdrop: a Tetris well that fills as the form does — one
        field filled reveals more of it, all three nearly completes it, and
        a successful send (ContactForm's own `contact-sent` event) clears it,
        in the same beat as the real T-Spin playing over the card. Purely
        decorative (aria-hidden, never the source of truth for form state),
        so it renders as an inert static scatter with no JS/reduced motion. */}
    <div class="well" id="contact-well" aria-hidden="true" role="presentation"></div>
    <div class="contact-inner">
      <div class="contact-copy">
        <p class="eyebrow">Get in touch</p>
        <h1>Contact</h1>
        <p class="lede">Have a project, a role, or just a question? Send a message below — I read every one.</p>
      </div>
      <div class="contact-card">
        <ContactForm />
      </div>
    </div>
  </div>
  <div class="seam" style="--seam-from: var(--wash-contact); --seam-to: var(--color-bg);"></div>
</BaseLayout>
<style>
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    margin: 0 0 var(--space-3);
  }
  .contact-band {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 90vh;
    background: var(--wash-contact);
    padding: var(--space-9) var(--space-5);
  }
  /* The waiting well. Cell on/off state is driven entirely by the script
     below (contact-progress / contact-sent) — nothing here reads form
     values directly, so the well stays inert if JS never runs. */
  /* Soft vignette: the well fills nearly the whole section (cells run from
     the second row down to the bottom now), staying solid through the middle
     and only feathering off at the outermost edges. Centered near the middle
     (50% / 52%) with a wide radius so the top rows read as filled rather than
     fading out early — an earlier tighter ellipse centered low left the top
     ~5 rows perpetually dim. The script analytically greys out cells behind the copy,
     and the card's frosted panel already covers whatever's behind it, so a fuller mask doesn't put blocks behind text. */
  .well {
    position: absolute;
    inset: 0;
    display: grid;
    gap: 4px;
    padding: var(--space-6);
    opacity: 0.85;
    mask-image: radial-gradient(ellipse 88% 82% at 50% 52%, black 0%, black 62%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 88% 82% at 50% 52%, black 0%, black 62%, transparent 100%);
  }
  /* Off cells are a transparent grey — visible enough that the empty grid
     reads as its own surface set apart from the wash behind it, but well below
     the lit blocks so those still clearly stand out as they fill in. */
  .well :global(div) {
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-text) 9%, transparent);
    transition: background-color 0.45s ease, opacity 0.45s ease, box-shadow 0.3s ease;
  }
  /* Lit cells carry enough of the T-piece hue to read as solid blocks against
     the wash rather than blending into it, but stay light enough not to shout
     — they sit in open space (never behind the card's text), so the fill is a
     legibility call, not a contrast one. */
  .well :global(div.on) {
    background: color-mix(in srgb, var(--tetris-t) 62%, var(--color-bg));
  }
  @media (prefers-reduced-motion: reduce) {
    .well :global(div) { transition: none; }
  }

  /* Plain centered two-column layout — the content deliberately does NOT try
     to align to the well's cells. Instead the script analytically greys out (leaves unlit)
     the cells behind the copy, measured from its real box in the script below, so occlusion
     stays accurate regardless of where the content lands. */
  .contact-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 68rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-8);
    align-items: center;
  }
  @media (max-width: 860px) {
    .contact-inner {
      grid-template-columns: 1fr;
      max-width: 34rem;
    }
  }
  .contact-copy h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }
  .contact-copy .lede {
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 34ch;
    color: var(--color-text-secondary);
    margin: 0;
  }
  /* The frosted-glass fill lives on ::before, one layer behind the card's
     real content, rather than directly on .contact-card. Chromium's
     backdrop-filter measurably bleeds into fully-opaque descendants'
     rendered color when it sits on an ancestor of them (confirmed: the Send
     button's computed style is exactly rgb(52,84,209)/white/opacity 1 with
     no filter of its own, yet axe's color-contrast check sampled a lighter
     blend once backdrop-filter lived here) — axe-core failed the button on
     contrast as a result. Moving backdrop-filter to a pseudo-element keeps
     it out of the button's ancestor chain entirely. */
  .contact-card {
    position: relative;
    z-index: 0;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: var(--space-6);
    transition: border-color 0.3s ease;
  }
  .contact-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  /* Pure-CSS "the board notices you're writing" cue — :has() reads the
     card's own focus-within state, no script involved, same
     attribute/state-driven spirit as ThemeToggle. Keys to --tetris-t, the
     same hue the send animation plays, so focusing previews the color that
     eventually completes it. */
  .contact-band:has(.contact-card:focus-within) .well { opacity: 0.85; }
  .contact-band:has(.contact-card:focus-within) .contact-card {
    border-color: color-mix(in srgb, var(--tetris-t) 45%, var(--line));
  }
  /* Page-wake entrance. This section is ~fully in view at load, the same as
     Home's hero — a scroll-triggered reveal would never fire, so this plays
     once on load instead (copy first, then the card). */
  .contact-copy, .contact-card {
    opacity: 0;
    transform: translateY(14px);
    animation: contact-in 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  .contact-copy { animation-delay: 0.05s; }
  .contact-card { animation-delay: 0.2s; }
  @keyframes contact-in {
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-copy, .contact-card { animation: none; opacity: 1; transform: none; }
  }
  /* Same mechanism as index.astro's own seams; only one is needed here
     (fading wash-hero back to flat before the Footer), matching how
     Home's own hero section has no seam *above* it either — a wash
     band only needs a seam where it meets another section, not at the
     page's very top. */
  .seam {
    position: relative;
    z-index: 1;
    height: 6rem;
    margin-top: -3rem;
    margin-bottom: -3rem;
    background: linear-gradient(to bottom, var(--seam-from), var(--seam-to));
    filter: blur(32px);
    pointer-events: none;
  }
</style>

<script>
  // The waiting well. Genuinely random scatter each load (same spirit as the
  // ambient Tetris board's real 7-bag randomness elsewhere on the site, not
  // a fixed pattern) — a fixed `baseline` set of cells that never changes
  // once built, plus a `pool` of additional cells revealed cumulatively as
  // ContactForm.astro's `contact-progress` events report more fields filled.
  // `contact-sent` (dispatched the instant the real T-Spin's rows start
  // flashing) drops the pool back to empty, so the backdrop clears in the
  // same beat as the card's own line clear.
  //
  // Purely decorative (aria-hidden on the container) and never the source of
  // truth for anything. Unlike ContactForm.astro's own tspin-stage (a
  // one-shot transient overlay that's fine to skip entirely), this well is
  // persistent background chrome — same category as TetrisHero's ambient
  // board, which still shows a static frame under reduced motion rather than
  // nothing. So the well always builds.
  {
    const band = document.getElementById('contact-band') as HTMLElement;
    const well = document.getElementById('contact-well') as HTMLElement;

    const CELL_SIZE = 42;
    const GAP = 4;
    // Cumulative share of the pool lit at each stage. Stage 0 (no fields
    // filled) is deliberately empty — the well starts blank and fills only as
    // the form does, so the backdrop reads as a direct response to typing.
    // Stage 3 (all fields filled) fills the entire pool, then the send clears it.
    const STAGE_FRACTIONS = [0, 0.4, 0.72, 1];

    let pool: HTMLElement[] = [];
    let cells: HTMLElement[] = [];
    // Cells sitting behind the copy or the card. They're never lit — they stay
    // the resting grey — so the content greys out exactly the blocks it covers,
    // by the content's real box shape. Recomputed on resize (cheap) so it stays
    // accurate as the centered content shifts, without rebuilding the grid.
    let occluded = new Set<HTMLElement>();
    let stageCounts: number[] = [0, 0, 0, 0];
    let currentStage = 0;
    // Bumped on every rebuild so a resize mid-animation can't have a stale
    // closure keep writing to cells that no longer exist — same guard
    // TetrisHero.astro uses for its own ambientGeneration.
    let generation = 0;
    let lastCols = 0;
    let lastRows = 0;

    function applyStage(stage: number, gen: number) {
      currentStage = stage;
      if (gen !== generation) return;
      const count = stageCounts[stage] ?? 0;
      // A pooled cell lights only if it's within the current fill count AND not
      // occluded by the copy — so blocks behind the text read as greyed out no
      // matter how full the well is.
      pool.forEach((cell, i) => cell.classList.toggle('on', i < count && !occluded.has(cell)));
    }

    function gridDims() {
      const w = well.clientWidth;
      const h = well.clientHeight;
      if (w === 0 || h === 0) return null;
      return {
        cols: Math.max(6, Math.floor((w + GAP) / (CELL_SIZE + GAP))),
        rows: Math.max(4, Math.floor((h + GAP) / (CELL_SIZE + GAP))),
      };
    }

    // Which cells the copy covers, computed analytically from each cell's pixel
    // rect (no per-cell getBoundingClientRect — that was the whole reason the
    // grid took ~2s to appear). Only the copy is greyed out: it's bare text
    // with no background, so lit blocks behind it would clash. The card is left
    // out on purpose — its own frosted panel already covers whatever's behind
    // it, so greying those cells too would just be a redundant hidden rectangle.
    function computeOcclusion(cols: number, rows: number) {
      occluded = new Set();
      const wellRect = well.getBoundingClientRect();
      if (!wellRect.width || !wellRect.height) return;
      const PAD = parseFloat(getComputedStyle(well).paddingTop) || 32;
      const cw = (wellRect.width - 2 * PAD - (cols - 1) * GAP) / cols;
      const ch = (wellRect.height - 2 * PAD - (rows - 1) * GAP) / rows;
      const M = 2; // px slack so a block peeking at a content edge still greys
      const boxes = ['.contact-copy']
        .map((s) => band.querySelector<HTMLElement>(s))
        .filter((el): el is HTMLElement => el !== null)
        .map((el) => el.getBoundingClientRect());
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const cell = cells[y * cols + x];
          if (!cell) continue;
          const left = wellRect.left + PAD + x * (cw + GAP);
          const top = wellRect.top + PAD + y * (ch + GAP);
          const right = left + cw;
          const bottom = top + ch;
          for (const b of boxes) {
            if (left < b.right + M && right > b.left - M && top < b.bottom + M && bottom > b.top - M) {
              occluded.add(cell);
              break;
            }
          }
        }
      }
    }

    function buildWell() {
      generation++;
      const gen = generation;
      const dims = gridDims();
      if (!dims) return;
      const { cols, rows } = dims;
      lastCols = cols;
      lastRows = rows;
      well.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
      well.style.gridTemplateRows = `repeat(${rows}, 1fr)`;

      // Fill from the second row down, leaving a single empty row of margin
      // along the very top so the well doesn't run flush to the section's top
      // edge. Occlusion (the copy) is applied at render time in applyStage, not
      // baked into the pool, so a resize can re-occlude without a rebuild.
      const candidates: number[] = [];
      const startRow = 1;
      for (let y = startRow; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          candidates.push(y * cols + x);
        }
      }
      for (let i = candidates.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [candidates[i], candidates[j]] = [candidates[j], candidates[i]];
      }
      stageCounts = STAGE_FRACTIONS.map((f) => Math.floor(candidates.length * f));

      // Build every cell into one fragment and insert it in a single DOM write
      // rather than appending in a loop, so the whole grid lands in one paint.
      cells = new Array(cols * rows);
      const frag = document.createDocumentFragment();
      for (let i = 0; i < cols * rows; i++) {
        frag.appendChild((cells[i] = document.createElement('div')));
      }
      well.innerHTML = '';
      well.appendChild(frag);
      pool = candidates.map((i) => cells[i]);
      computeOcclusion(cols, rows);
      applyStage(currentStage, gen);
    }

    band.addEventListener('contact-progress', (e) => {
      applyStage((e as CustomEvent<{ stage: number }>).detail.stage, generation);
    });
    band.addEventListener('contact-sent', () => applyStage(0, generation));

    buildWell();
    // On resize, only rebuild the whole grid when the column/row count actually
    // changes; otherwise just re-measure what the (now shifted) content covers
    // and re-light — cheap, no re-randomised flicker.
    let rafId = 0;
    window.addEventListener('resize', () => {
      if (rafId) return;
      rafId = requestAnimationFrame(() => {
        rafId = 0;
        const dims = gridDims();
        if (!dims) return;
        if (dims.cols !== lastCols || dims.rows !== lastRows) {
          buildWell();
        } else {
          computeOcclusion(lastCols, lastRows);
          applyStage(currentStage, generation);
        }
      });
    });
  }
</script>
