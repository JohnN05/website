---
import BaseLayout from './BaseLayout.astro';
import CapybaraProgress from '../components/CapybaraProgress.astro';
import { accentForTag } from '../lib/tags';

interface Props {
  title: string;
  date: Date;
  tags: string[];
}
const { title, date, tags } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(date);
---
<BaseLayout title={`${title} — John Ng`}>
  <CapybaraProgress />
  <article class="prose">
    <div class="meta">
      <span class="meta-date">{formattedDate}</span>
      <ul class="tags">
        {tags.map((tag) => <li class={`tag tag-${accentForTag(tag)}`}>{tag}</li>)}
      </ul>
    </div>
    <h1>{title}</h1>
    <slot />
  </article>
</BaseLayout>
<style>
  .prose {
    font-family: 'Source Serif 4', serif;
    max-width: 70ch;
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-8);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
</style>
