---
import Nav from '../components/Nav.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import SkipLink from '../components/SkipLink.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** OG/Twitter image path relative to the site root; absolute URL is derived. */
  image?: string;
  /** Open Graph type — 'article' for project write-ups. */
  type?: 'website' | 'article';
  /** robots meta content, e.g. 'noindex' for the 404 page. */
  robots?: string;
}
const {
  title,
  description = 'John Ng — software engineer portfolio',
  image = '/og-image.png',
  type = 'website',
  robots,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
// Home is the only page built out of full-height scroll-snap sections, so it is
// the only page that may be a snap container. Derived from the route here, the
// same way Nav.astro derives its own isHome, rather than each page opting in.
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en" data-snap={isHome ? 'sections' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Ng" />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAF7F0" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0F1E3D" />
    <meta property="og:site_name" content="John Ng" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <slot name="head" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon-180x180.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600&family=Source+Serif+4:wght@400;500&family=Inter:wght@400;500&family=IBM+Plex+Mono:wght@400;500&family=Unbounded:wght@800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;

        // Gates global.css's scroll-reveal hidden state. It lives here, inline
        // and render-blocking, for the same reason the theme line above does:
        // it must land before first paint. A module script runs after paint, so
        // gating there would let already-visible content paint at rest and then
        // transition OUT — a flash on every load.
        //
        // Reduced motion leaves the attribute unset, as does this script not
        // running at all, so no-JS renders every [data-reveal] at rest. Note
        // the narrower hole that pre-paint gating opens, since it is not the
        // one the plan's constraint describes: the gate and the revealer are
        // now separate scripts, so if index.astro's reveal module fails to
        // load or throws while this line still runs, off-screen content stays
        // hidden with no error. Anything that sets this attribute must be
        // render-blocking and must not depend on that module.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.dataset.motion = 'on';
        }
      })();
    </script>
  </head>
  <body>
    <SkipLink />
    <Nav />
    <MobileNav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
