---
import ThemeToggle from './ThemeToggle.astro';
---
<div class="mobile-nav">
  <nav class="mobile-bar" aria-label="Primary">
    <a href="/" class="mobile-wordmark wordmark">JOHN NG</a>
    <button id="mobile-nav-toggle" class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-drawer">
      <span aria-hidden="true">&#9776;</span>
      <span class="sr-only">Open navigation menu</span>
    </button>
  </nav>
  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <a href="/projects">Projects</a>
    <a href="/contact">Contact</a>
    <ThemeToggle />
  </div>
</div>
<style>
  .mobile-nav { display: none; }
  @media (max-width: 768px) {
    .mobile-nav { display: block; scroll-snap-align: start; }
  }
  .mobile-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
  }
  .mobile-wordmark {
    text-decoration: none;
    color: var(--color-text);
    letter-spacing: 0.05em;
  }
  .mobile-nav-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    font-size: 1.25rem;
    padding: var(--space-2);
  }
  .mobile-drawer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: 0 var(--space-5) var(--space-5);
  }
  .mobile-drawer[hidden] { display: none; }
  .mobile-drawer a {
    text-decoration: none;
    color: var(--color-text);
  }
</style>
<script>
  const toggle = document.getElementById('mobile-nav-toggle')!;
  const drawer = document.getElementById('mobile-drawer') as HTMLElement;

  toggle.addEventListener('click', () => {
    const willOpen = drawer.hidden;
    drawer.hidden = !willOpen;
    toggle.setAttribute('aria-expanded', String(willOpen));
  });
</script>
