---
import ThemeToggle from './ThemeToggle.astro';
import PieceMark from './PieceMark.astro';
---
<div class="mobile-nav">
  <nav class="mobile-bar" aria-label="Primary">
    <a href="/" class="mobile-home">
      <PieceMark layout="stack" reveals={false} trigger="hover" class="mobile-wordmark" />
    </a>
    <button id="mobile-nav-toggle" class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-drawer">
      <span aria-hidden="true">&#9776;</span>
      <span class="sr-only">Open navigation menu</span>
    </button>
  </nav>
  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <a href="/projects">Projects</a>
    <a href="/contact">Contact</a>
    <ThemeToggle />
  </div>
</div>
<style>
  .mobile-nav { display: none; }
  @media (max-width: 768px) {
    .mobile-nav { display: block; scroll-snap-align: start; }
  }
  .mobile-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
  }
  .mobile-home {
    text-decoration: none;
    color: var(--color-text);
    display: flex;
    /* Lives here, not on .mobile-wordmark: that class is passed as a prop
       into PieceMark, whose root element carries PieceMark's own Astro cid,
       not this file's — a rule targeting it from this scoped <style> block
       would never match. This wrapper holds nothing but the mark, so the
       size just inherits down, same mechanism index.astro's .nameplate
       already relies on. */
    font-size: 1.05rem;
  }
  .mobile-nav-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    font-size: 1.25rem;
    padding: var(--space-2);
  }
  .mobile-drawer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: 0 var(--space-5) var(--space-5);
  }
  .mobile-drawer[hidden] { display: none; }
  .mobile-drawer a {
    text-decoration: none;
    color: var(--color-text);
  }
</style>
<script>
  const toggle = document.getElementById('mobile-nav-toggle')!;
  const drawer = document.getElementById('mobile-drawer') as HTMLElement;

  toggle.addEventListener('click', () => {
    const willOpen = drawer.hidden;
    drawer.hidden = !willOpen;
    toggle.setAttribute('aria-expanded', String(willOpen));
  });
</script>
