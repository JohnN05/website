---
import ThemeToggle from './ThemeToggle.astro';
import PieceMark from './PieceMark.astro';

// Same active-route derivation as Nav.astro's rail: the drawer links carry
// aria-current too, so mobile screen-reader users get the same "you are here"
// the desktop rail's tick provides visually.
const path = Astro.url.pathname;
const isProjects = path === '/projects' || path.startsWith('/projects/');
const isContact = path === '/contact' || path.startsWith('/contact/');
---
<!-- One <nav> landmark wrapping bar AND drawer: when the drawer was a sibling
     of the <nav>, mobile screen readers found a "Primary" landmark containing
     only the logo and a button — the actual navigation links sat in a
     landmark-less div. -->
<nav class="mobile-nav" aria-label="Primary">
  <div class="mobile-bar">
    <a href="/" class="mobile-home">
      <PieceMark layout="stack" reveals={false} trigger="hover" class="mobile-wordmark" />
    </a>
    <button id="mobile-nav-toggle" class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-drawer">
      <span aria-hidden="true">&#9776;</span>
      <span class="sr-only">Navigation menu</span>
    </button>
  </div>
  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <a href="/projects/" aria-current={isProjects ? 'page' : undefined}>Projects</a>
    <a href="/contact/" aria-current={isContact ? 'page' : undefined}>Contact</a>
    <ThemeToggle />
  </div>
</nav>
<style>
  .mobile-nav { display: none; }
  @media (max-width: 768px) {
    .mobile-nav { display: block; scroll-snap-align: start; }
  }
  .mobile-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
  }
  .mobile-home {
    text-decoration: none;
    color: var(--color-text);
    display: flex;
    /* Lives here, not on .mobile-wordmark: that class is passed as a prop
       into PieceMark, whose root element carries PieceMark's own Astro cid,
       not this file's — a rule targeting it from this scoped <style> block
       would never match. This wrapper holds nothing but the mark, so the
       size just inherits down, same mechanism index.astro's .nameplate
       already relies on. */
    font-size: 1.05rem;
  }
  .mobile-nav-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    font-size: 1.25rem;
    padding: var(--space-2);
  }
  .mobile-drawer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: 0 var(--space-5) var(--space-5);
    /* Open state reads as its own panel against the page below — without the
       hairline the drawer's links floated on the same wash as the content
       they had pushed down, with no edge marking where the nav ends. */
    border-bottom: 1px solid var(--line);
  }
  .mobile-drawer[hidden] { display: none; }
  .mobile-drawer a {
    text-decoration: none;
    color: var(--color-text);
  }
</style>
<script>
  const toggle = document.getElementById('mobile-nav-toggle')!;
  const drawer = document.getElementById('mobile-drawer') as HTMLElement;

  toggle.addEventListener('click', () => {
    const willOpen = drawer.hidden;
    drawer.hidden = !willOpen;
    toggle.setAttribute('aria-expanded', String(willOpen));
  });

  // Escape closes an open drawer and returns focus to the toggle — without it
  // a keyboard user has to Tab through every drawer link to get out.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || drawer.hidden) return;
    drawer.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.focus();
  });
</script>
