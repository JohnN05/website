---
import {
  NAMEPLATE_LINES,
  PIECES,
  pieceBlocks,
  pieceForLetter,
} from '../lib/nameplate';

interface Props {
  /** 'stack' = JOHN over NG (the rail, the mobile bar). 'inline' = one line
   *  (the Home hero). */
  layout: 'stack' | 'inline';
  /** Whether this mark performs the reveal on this page. Exactly one mark per
   *  page should be true — see the ownership rule in CLAUDE.md. */
  reveals?: boolean;
  /** 'hover' = plays on pointer/focus. 'load' = plays on load, repeats on a
   *  slow cadence while the mark is on screen, and replays on click. */
  trigger?: 'hover' | 'load';
  class?: string;
}

const { layout, reveals = false, trigger = 'hover', class: className } = Astro.props;

const [first, second] = NAMEPLATE_LINES;
const lines = layout === 'stack' ? [first, second] : [`${first} ${second}`];
---
<span
  class:list={['piece-mark', `layout-${layout}`, className]}
  data-piece-mark
  data-owns={String(reveals)}
  data-trigger={trigger}
>
  {lines.map((line, lineIndex) => (
    <Fragment>
      {/* .piece-mark is display: flex; flex-direction: column, so the two
          .line children are already blockified and accname computation
          inserts a space at that boundary on its own — confirmed by removing
          this span from a live DOM and finding the accessible name still
          comes out "JOHN NG" verbatim. So this span isn't load-bearing today;
          it's here to make that boundary space explicit rather than have the
          accessible name depend on .piece-mark staying a flex column. */}
      {lineIndex > 0 && <span class="sr-only">&nbsp;</span>}
      {/* Second, different instance of the same spacing problem: `.line` is
          `display: flex`, which blockifies its `.ch` letter children, and
          accessible-name computation inserts an implicit space at every
          non-inline box boundary — confirmed against a real Chromium AX
          tree — so without a fix here the name comes out "J O H N N G"
          instead of "JOHN NG". Unlike the line-gap case above, a literal
          space character can't fix this: there's no character to insert
          between individual letters without visually breaking the rendered
          word. aria-label is the only way to reach it, and it isn't a
          maintained duplicate at risk of drifting: it's the same `line`
          value already driving the letters below, read directly instead of
          asking the browser to reconstruct it from a DOM shape that can't
          carry it losslessly. */}
      <span class="line" aria-label={line}>
        {[...line].map((letter) => {
          const key = pieceForLetter(letter);
          const piece = key ? PIECES[key] : null;
          return (
            <span class:list={['ch', letter === ' ' && 'sp']} data-piece={key ?? undefined}>
              {piece && (
                // The grid is the piece's own box — 3x3 for the J, 2x2 for the
                // O — not one shared size. Written here as a literal because
                // CSS `repeat()` needs an integer and can't read a custom
                // property; rendering it from `boxSize` is what keeps the CSS
                // and the model from drifting apart, so there's nothing for a
                // test to pin.
                <span
                  class="lattice"
                  aria-hidden="true"
                  style={`grid-template-columns:repeat(${piece.boxSize},1fr);grid-template-rows:repeat(${piece.boxSize},1fr)`}
                >
                  {pieceBlocks(piece).map((block) => (
                    <b style={`grid-row:${block.row};grid-column:${block.col}`}></b>
                  ))}
                </span>
              )}
              <span class="glyph" set:html={letter === ' ' ? '&nbsp;' : letter}></span>
            </span>
          );
        })}
      </span>
    </Fragment>
  ))}
</span>

<style>
  .piece-mark {
    font-family: var(--font-mark);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    display: flex;
    flex-direction: column;
    gap: var(--mark-line-gap, 2px);
    /* The well's ceiling. Nothing here leaves the box today, but the mark is a
       Tetris object and a piece above the top edge is out of play. */
    overflow: hidden;
  }
  .layout-inline {
    flex-direction: row;
    letter-spacing: -0.01em;
  }
  .line {
    display: flex;
    gap: var(--mark-cell-gap, 3px);
  }

  .ch {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.05em;
    height: 1.16em;
    color: var(--cell, var(--color-text));
  }
  .ch.sp {
    min-width: 0.4em;
  }
  /* Only J and O — the only letters in "JOHN NG" that are also tetromino
     letters (I/O/T/S/Z/J/L). Tokens live in tokens.css so the mark and the
     ambient board read the literal same values. */
  .ch[data-piece='J'] { --cell: var(--tetris-j); }
  .ch[data-piece='O'] { --cell: var(--tetris-o); }

  /* Geometry is deliberately absent here: the box's size and position are
     measured onto the letter's ink by the script below, because CSS cannot see
     where a glyph's ink actually sits inside its line box. An earlier version
     pinned the box to the letter *cell* instead — a box wider and taller than
     the glyph, and lower — which is why the pieces never lined up with the
     word. Nothing shows before the script runs: the box is transparent at rest.
     Column/row counts come from the piece's own boxSize, inline above. */
  .lattice {
    position: absolute;
    display: grid;
    gap: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .lattice b {
    background: var(--cell);
    opacity: 0;
    transition: opacity 60ms steps(1, end);
  }
  /* Blocks land one at a time rather than all at once — the piece assembling
     itself. Delays key off DOM order, which the script never reorders: it
     rewrites each block's grid placement in place. */
  .lattice b:nth-child(1) { transition-delay: 0ms; }
  .lattice b:nth-child(2) { transition-delay: 30ms; }
  .lattice b:nth-child(3) { transition-delay: 60ms; }
  .lattice b:nth-child(4) { transition-delay: 90ms; }

  .glyph {
    position: relative;
    z-index: 1;
  }
  /* No transform transition, deliberately: the tip is never something to watch
     happen. On load the letter is already lying down (see below) and on a
     replay it snaps — so, like the turn, the J can never be caught at an angle
     no tetromino occupies. */
  .ch[data-piece] .glyph {
    transition: opacity 90ms steps(2, end);
  }

  /* The letter lies down to meet the piece where it actually spawns.
     PIECES.J spawns flat (`... / X.. / XXX`), which is the letter J rotated a
     quarter-turn clockwise — so the blocks would otherwise fill in on their
     side underneath a glyph still standing up. The piece is not what's wrong
     there: its spawn and its counter-clockwise turn are real Tetris moves and
     are untouched. The letter is what meets it, and the turn stands both up.

     J only, and not by special-casing: the O is its own rotation's fixed point
     (a 2x2 square in a 2x2 box maps onto itself), so its spawn already is its
     letter's orientation and there is nothing for it to lie down to.

     Two selectors, because "before the first play" and "during a replay" are
     genuinely different states:

     1. The load-triggered mark paints tipped, before any script runs. This has
        to be CSS gated on html[data-motion='on'] — the render-blocking inline
        script in BaseLayout.astro's <head> — and not a class this component's
        own module adds: a module script runs after paint, so tipping from
        there is precisely the "loads upright, then visibly rotates" the gate
        exists to avoid. Reduced motion leaves data-motion unset, as does JS not
        running at all, so both render the J plainly upright and never tip it —
        the same one gate the scroll reveal already depends on, rather than a
        second reduced-motion check here that could drift away from it.
     2. [data-tipped] is the script's own flag, for a replay: by then the letter
        is upright and data-played is set, so rule 1 no longer applies. */
  :global(html[data-motion='on'])
    .piece-mark[data-trigger='load'][data-owns='true']:not([data-played])
    .ch[data-piece='J']
    .glyph,
  .piece-mark[data-tipped] .ch[data-piece='J'] .glyph {
    transform: rotate(90deg);
  }

  .revealing .lattice { opacity: 1; }
  .revealing .lattice b { opacity: 1; }
  /* The letter gets out of the way rather than being painted back over the
     piece in the background colour. The knock-out only ever read as a knock-out
     because the piece landed where the letter wasn't; now that the piece covers
     the letter's ink exactly, a background-coloured glyph hollows the piece out
     to a thin fringe. Fading also takes the reveal out of axe's contrast rule
     entirely — there's no longer a frame where a letter is painted its own
     background colour. */
  .revealing .ch[data-piece] .glyph { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .lattice b,
    .ch[data-piece] .glyph {
      transition: none;
    }
  }

</style>

<script>
  import { PIECES, pieceBlocks, pieceForLetter, type Piece } from '../lib/nameplate';

  // On the Home hero the reveal fires at document.fonts.ready, which lands in
  // the same instant as first paint — the whole play was over before a visitor
  // had looked at the word. Hold the letters first so there is a "before" to
  // notice the change against: long enough for a newcomer's eyes to settle on
  // the page.
  const LOAD_DELAY_MS = 1500;
  // Even well-timed, one play is a moment a visitor can miss. The load-triggered
  // mark replays on a slow cadence so anyone watching the hero for a handful of
  // seconds catches it — the same bet the board's ambient loop already makes.
  // Measured rest to rest (scheduled when the previous play completes), so the
  // name sits still the overwhelming majority of the time and the loop reads as
  // ambient rather than blinking. Paused while the mark is off-screen or the
  // tab is hidden; click remains the on-demand play.
  const REPLAY_INTERVAL_MS = 10000;
  // A beat on the tipped letter before the blocks arrive. On load the letter is
  // already lying down and has been for LOAD_DELAY_MS, so this only really
  // buys anything on a replay, where the tip snaps in at play start.
  const TIP_HOLD_MS = 90;
  // Four blocks staggered 30ms apart, each snapping in over 60ms.
  const FILL_MS = 150;
  // A beat on the spawn state before the turn, and another on the turned state
  // after it — a snap with no dwell on either side reads as a glitch. Kept
  // short on purpose: long dwells were tried and read as the piece stalling,
  // not as a piece. Being noticeable is the load delay's job, not theirs.
  const BEFORE_TURN_MS = 70;
  const AFTER_TURN_MS = 130;
  const BACK_MS = 150;

  const wait = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms));

  /**
   * Apply a rotation state by rewriting each block's grid placement.
   *
   * This is the whole reason the turn is blocky: grid-row/grid-column are not
   * transitionable, so the piece jumps between rotation states in one frame
   * and can never be caught at an angle no tetromino occupies. It also avoids
   * the trap this repo already hit with the ambient piece — SHAPES defines
   * each rotation as an independently authored array, so interpolating
   * between two of them sends every cell down its own unrelated diagonal.
   *
   * The positions come from the same pieceBlocks() the markup was rendered
   * from, so there is no second formula to drift out of sync with the first.
   */
  function applyRotation(mark: HTMLElement, rotated: boolean): void {
    forEachPiece(mark, (ch, piece) => {
      const cells = ch.querySelectorAll<HTMLElement>('.lattice b');
      pieceBlocks(piece, rotated).forEach((block, i) => {
        const cell = cells[i];
        if (!cell) return;
        cell.style.gridRow = String(block.row);
        cell.style.gridColumn = String(block.col);
      });
    });
  }

  function forEachPiece(
    mark: HTMLElement,
    fn: (ch: HTMLElement, piece: Piece) => void
  ): void {
    mark.querySelectorAll<HTMLElement>('.ch[data-piece]').forEach((ch) => {
      const key = pieceForLetter(ch.dataset.piece ?? '');
      if (key) fn(ch, PIECES[key]);
    });
  }

  // Canvas is the only way to ask where a glyph's ink actually is: the DOM will
  // report the line box, which is taller and wider than the letter and says
  // nothing about where the letter sits inside it.
  const measureCtx = document.createElement('canvas').getContext('2d');

  /**
   * Size and place a piece's box onto its letter's ink.
   *
   * Two things have to be true for the reveal to read: the piece must cover the
   * letter it replaces, and it must still be a real tetromino. So the box is
   * scaled to the letter's ink height and divided into boxSize blocks — which
   * is why the O's blocks come out larger than the J's — and it is placed by
   * where the *turned* shape has to land, not the spawn. A rotation happens
   * inside a box that stays put, so anchoring the box on the final state is
   * what lets the piece turn *into* the letter.
   */
  function measure(ch: HTMLElement, piece: Piece): void {
    const glyph = ch.querySelector<HTMLElement>('.glyph');
    const box = ch.querySelector<HTMLElement>('.lattice');
    if (!glyph || !box || !measureCtx) return;

    const style = getComputedStyle(glyph);
    measureCtx.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
    const m = measureCtx.measureText(ch.dataset.piece ?? '');

    // An inline box's border box is its font's ascent+descent, so its top edge
    // is exactly one ascent above the baseline.
    const chRect = ch.getBoundingClientRect();
    // Measure the glyph's LAYOUT box, not its painted one. getBoundingClientRect
    // includes transforms, and by the time this runs the J is already tipped a
    // quarter-turn (that's CSS at first paint, before any script) — so its rect
    // comes back with width and height swapped and its left edge moved by
    // (w - h) / 2, which silently placed the J's piece ~9px off its letter.
    //
    // The vertical term survived that by pure luck: rotating about the centre
    // shifts top by (h - w) / 2 while height becomes w, and the two cancel in
    // the baseline formula below. Nothing cancels horizontally. Suppressing the
    // transform for the read is exact and costs one forced reflow at measure
    // time (load and debounced resize only); no paint can happen inside this
    // synchronous block, so nothing flickers.
    const painted = glyph.style.transform;
    glyph.style.transform = 'none';
    const glyphRect = glyph.getBoundingClientRect();
    glyph.style.transform = painted;
    const baseline =
      glyphRect.top -
      chRect.top +
      (glyphRect.height - (m.fontBoundingBoxAscent + m.fontBoundingBoxDescent)) / 2 +
      m.fontBoundingBoxAscent;
    const originX = glyphRect.left - chRect.left;

    const inkLeft = originX - m.actualBoundingBoxLeft;
    const inkRight = originX + m.actualBoundingBoxRight;
    const inkTop = baseline - m.actualBoundingBoxAscent;
    const inkBottom = baseline + m.actualBoundingBoxDescent;
    const block = (inkBottom - inkTop) / piece.boxSize;
    if (!(block > 0)) return;

    const turned = pieceBlocks(piece, true);
    const rows = turned.map((b) => b.row);
    const cols = turned.map((b) => b.col);
    const minRow = Math.min(...rows);
    const minCol = Math.min(...cols);
    const width = (Math.max(...cols) - minCol + 1) * block;
    const height = (Math.max(...rows) - minRow + 1) * block;

    // Sit the turned shape on the letter's ink and centre it there, then back
    // out to where that puts the box's own top-left corner.
    box.style.left = `${(inkLeft + inkRight) / 2 - width / 2 - (minCol - 1) * block}px`;
    box.style.top = `${inkBottom - height - (minRow - 1) * block}px`;
    box.style.width = `${piece.boxSize * block}px`;
    box.style.height = `${piece.boxSize * block}px`;
  }

  // Same convention as the Tetris ambient loop: check reduced motion once, and
  // if it's set, never attach. The mark renders at rest with no script.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const marks = Array.from(document.querySelectorAll<HTMLElement>('[data-piece-mark]'));
    const measureAll = () => marks.forEach((mark) => forEachPiece(mark, measure));

    // The hero's mark is sized in vw, so a resize changes the ink each piece
    // has to land on.
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(measureAll, 150);
    });

    // Nothing may play before the geometry exists, and the geometry is measured
    // off Unbounded — measuring against the fallback face would place every
    // piece off its letter and then leave it there, since nothing re-measures
    // on its own once the real face swaps in.
    void document.fonts.ready.then(() => {
      measureAll();

      for (const mark of marks) {
        let playing = false;

        const play = async (): Promise<void> => {
          // Ownership: exactly one mark per page performs. The flag is set from
          // the route at build time; this is the only place it's read.
          if (playing || mark.dataset.owns !== 'true') return;
          playing = true;

          // On the first load this is already true in CSS and changes nothing —
          // the letter has been lying down since first paint. It's a replay
          // that needs it: by then data-played is set and the letter is back
          // upright, so this is what lays it down again.
          mark.dataset.tipped = 'true';
          await wait(TIP_HOLD_MS);
          mark.classList.add('revealing');
          await wait(FILL_MS + BEFORE_TURN_MS);
          applyRotation(mark, true);
          mark.dataset.turned = 'true';
          await wait(AFTER_TURN_MS);
          // Stand the letter back up while it is still faded out, so the
          // upright J is simply what fades back in. data-played retires the
          // CSS load rule for good: the tip is a loan for the reveal, not a new
          // resting state, and the name reads normally from here on.
          delete mark.dataset.tipped;
          mark.dataset.played = 'true';
          mark.classList.remove('revealing');
          await wait(BACK_MS);
          // Reset the rotation only once the blocks are invisible, so the turn
          // never plays backwards on screen.
          applyRotation(mark, false);
          delete mark.dataset.turned;
          // Lets an e2e test prove two reads landed on the same play, the same
          // way TetrisHero.astro's data-cycle does for the ambient loop.
          mark.dataset.cycle = String(Number(mark.dataset.cycle ?? '0') + 1);
          playing = false;
        };

        const host = mark.closest('a, button') ?? mark;

        if (mark.dataset.trigger === 'load') {
          // A click is the visitor already watching, so a replay starts on the
          // beat they asked for it.
          host.addEventListener('click', () => void play());

          // The loop is only wired for the mark that performs — a non-owner
          // would spin a timer whose every play() is gated to a no-op.
          if (mark.dataset.owns === 'true') {
            let onScreen = true;
            let playedOnce = false;
            let timer = 0;

            // One place that (re)starts the countdown to the next play, so
            // every wake source — load, scrolling the hero back into view,
            // returning to the tab — lands on the same logic, and pausing is
            // just not rescheduling. The first play waits out LOAD_DELAY_MS;
            // every later one waits REPLAY_INTERVAL_MS after the previous play
            // completes. IntersectionObserver fires once on observe(), so the
            // initial schedule effectively starts from there.
            const wake = (): void => {
              window.clearTimeout(timer);
              if (!onScreen || document.hidden) return;
              timer = window.setTimeout(() => {
                void play().then(() => {
                  playedOnce = true;
                  wake();
                });
              }, playedOnce ? REPLAY_INTERVAL_MS : LOAD_DELAY_MS);
            };

            new IntersectionObserver(([entry]) => {
              onScreen = entry?.isIntersecting ?? true;
              wake();
            }).observe(mark);
            document.addEventListener('visibilitychange', wake);
            wake();
          }
        } else {
          host.addEventListener('mouseenter', () => void play());
          host.addEventListener('focus', () => void play());
        }
      }
    });
  }
</script>
