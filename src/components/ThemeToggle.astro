<!-- No id. This component is mounted twice on every page (the desktop rail and
     the mobile drawer), and an id would therefore be duplicated — which is not
     a validity nitpick here but the actual bug that shipped once: a single
     getElementById returned only the first in DOM order (the rail's), leaving
     the drawer's button inert and dark mode unreachable for every mobile
     visitor. The class is the hook, and it works for any number of mounts.

     The mark is an S tetromino, CSS-driven off html[data-theme], NOT toggled by
     this component's script: light = piece at rest (sun-tinted), dark = same
     piece snap-rotated 90° (moon-tinted). Because BaseLayout sets data-theme
     before first paint, the piece renders in the correct resting state with no
     flash and no JS. The click handler only flips data-theme (+ persists); the
     rotation falls out of the CSS transition on that attribute change, using
     steps() so it snaps blockily like every other rotation on the site rather
     than gliding. Under reduced motion the transition is removed but the
     resting orientation + tint still swap, so the current mode is never
     ambiguous. -->
<button class="theme-toggle" type="button" aria-label="Toggle light or dark theme">
  <svg class="spiece-svg" viewBox="0 0 54 54" width="30" height="30" aria-hidden="true">
    <!-- S-piece, spawn (horizontal): top row cols 1,2 · mid row cols 0,1. The
         whole group rotates about the viewBox centre; a 90° turn reads as a
         genuine SRS spin (S has no 180° symmetry to hide behind). -->
    <g class="spiece">
      <rect x="19" y="9"  width="14" height="14" rx="2"></rect>
      <rect x="33" y="9"  width="14" height="14" rx="2"></rect>
      <rect x="5"  y="23" width="14" height="14" rx="2"></rect>
      <rect x="19" y="23" width="14" height="14" rx="2"></rect>
    </g>
  </svg>
  <!-- Discoverability layer: a sun/moon and the current mode word, so the
       control advertises its state to sighted users. Decorative — the button's
       accessible name is the aria-label above (the action), not this text. -->
  <span class="tt-label" aria-hidden="true">
    <svg class="tt-sky sun" viewBox="0 0 24 24" width="15" height="15">
      <circle cx="12" cy="12" r="4.6"></circle>
      <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.5 4.5l2 2M17.5 17.5l2 2M19.5 4.5l-2 2M6.5 17.5l-2 2"></path>
      </g>
    </svg>
    <svg class="tt-sky moon" viewBox="0 0 24 24" width="15" height="15">
      <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
    </svg>
    <span class="tt-mode tt-mode-light">Light</span>
    <span class="tt-mode tt-mode-dark">Dark</span>
  </span>
</button>
<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    padding: var(--space-2) 0;
    font: inherit;
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .spiece-svg { display: block; overflow: visible; flex-shrink: 0; }
  .spiece {
    transform-box: view-box;
    transform-origin: 27px 27px;
    /* steps() = blocky snap, matching the site's grid-rewrite rotations
       elsewhere; no eased glide. */
    transition: transform 0.42s steps(3, end);
  }
  .spiece rect { fill: var(--color-accent-clay); transition: fill 0.3s ease; }

  /* Dark = the piece spins a quarter turn and cools to the teal moon tint.
     Light is the resting default (no rule needed), which is also the correct
     no-JS / unset fallback. */
  :global(html[data-theme='dark']) .spiece { transform: rotate(90deg); }
  :global(html[data-theme='dark']) .spiece rect { fill: var(--tetris-i); }

  .tt-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }
  .tt-sky { display: block; flex-shrink: 0; }
  .tt-sky.sun { fill: var(--color-accent-clay); }
  .tt-sky.moon { fill: var(--tetris-i); }

  /* Light is the default: show sun + "Light", hide the dark pair. */
  .tt-sky.moon,
  .tt-mode-dark { display: none; }
  :global(html[data-theme='dark']) .tt-sky.sun,
  :global(html[data-theme='dark']) .tt-mode-light { display: none; }
  :global(html[data-theme='dark']) .tt-sky.moon { display: block; }
  :global(html[data-theme='dark']) .tt-mode-dark { display: inline; }

  @media (prefers-reduced-motion: reduce) {
    .spiece { transition: none; }
    .spiece rect { transition: none; }
  }
</style>
<script>
  import { getInitialTheme, toggleTheme, persistTheme, type Theme } from '../lib/theme';

  function readCurrentTheme(): Theme {
    const fromAttribute = document.documentElement.dataset.theme as Theme | undefined;
    return fromAttribute ?? getInitialTheme(localStorage, (query) => window.matchMedia(query));
  }

  // Bound by class across every mount, not by id — Astro bundles this <script>
  // once per page however many times the component is mounted, so a
  // single-element lookup would bind one button and leave the rest dead (which
  // is exactly what happened to the mobile drawer's copy once).
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const next = toggleTheme(readCurrentTheme());
      // The piece (and the sun/moon/label) are driven entirely by this
      // attribute in CSS, so flipping it here animates every mount at once and
      // needs no per-button visual bookkeeping.
      document.documentElement.dataset.theme = next;
      persistTheme(localStorage, next);
    });
  }
</script>
