<div class="minesweeper" id="minesweeper">
  <div class="ms-header">
    <!-- role="status" (an implicit polite live region) because this is where
         "You hit a mine." and "You cleared the board!" are written. Without it
         nothing announces the end of the game: the cell labels don't convey it,
         and every later Enter silently no-ops behind the gameOver guard, so a
         screen-reader user is left pressing keys at a board that has already
         finished. Polite, not assertive — it should follow the move the player
         just made, not interrupt it. -->
    <span id="ms-status" role="status">Mines: 10</span>
    <button id="ms-reset" type="button">Reset</button>
  </div>
  <div class="ms-grid" id="ms-grid" role="grid" aria-label="Minesweeper board" aria-describedby="ms-help"></div>
  <p class="ms-help" id="ms-help">Click or Enter to reveal · right-click, Space, or a long-press to flag</p>
</div>
<style>
  /* The board reads as one of the site's panels (same card language as the
     project cards / contact card) rather than a bare grid floating in the wash. */
  .minesweeper {
    display: inline-block;
    background: color-mix(in srgb, var(--color-text) 3%, var(--color-bg));
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: var(--space-4);
  }
  .ms-grid {
    display: grid;
    grid-template-columns: repeat(9, clamp(1.7rem, 7.5vw, 2rem));
    gap: 3px;
  }
  /* :global() is required here because the grid cells are created at
     runtime via document.createElement (see the script below), so they
     never receive Astro's scoped data-astro-cid attribute and would
     otherwise not match these rules at all. */
  /* role="row" wrapper divs are required for valid ARIA grid semantics
     (a role="grid" element's children must be role="row", which in turn
     must contain role="gridcell" children) but must not affect the
     visual layout, which relies on the buttons being direct children of
     the CSS grid container; display: contents removes the wrapper from
     the box-layout tree while keeping it in the accessibility tree. */
  .ms-grid :global([role='row']) {
    display: contents;
  }
  .ms-grid :global(button) {
    width: 100%;
    aspect-ratio: 1;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.9rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--color-text) 9%, var(--color-bg));
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--color-text);
    cursor: pointer;
    transition: background-color 0.12s ease;
  }
  .ms-grid :global(button:hover) {
    background: color-mix(in srgb, var(--color-text) 16%, var(--color-bg));
  }
  .ms-grid :global(button:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }
  /* data-revealed (not aria-pressed) drives the "revealed" visual state:
     role="gridcell" doesn't permit aria-pressed (that state belongs to
     toggle buttons), and the cell's aria-label already conveys revealed/
     flagged/mine/adjacent-count state to assistive tech, so this is a
     plain styling hook rather than an accessibility attribute. */
  /* revealed = opened: recede to the flat page ground so numbers keep full
     --color-text contrast in both themes. The old revealed background was
     --color-text-secondary, which put ivory numbers on a light grey in dark
     mode — the unreadable case the redesign fixes. */
  .ms-grid :global(button[data-revealed='true']) {
    background: var(--color-bg);
    cursor: default;
  }
  .ms-grid :global(button[data-revealed='true']:hover) {
    background: var(--color-bg);
  }
  .ms-grid :global(button[data-mine='true']) {
    background: color-mix(in srgb, var(--color-error) 22%, var(--color-bg));
  }
  /* Flags keep the red the emoji used to provide for free; mines stay plain
     text color against their already error-tinted background. */
  .ms-grid :global(button[data-flagged='true']) {
    color: var(--color-error);
  }
  .ms-grid :global(button svg) {
    display: inline-block;
    vertical-align: middle;
  }
  .ms-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  #ms-status {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    min-width: 0;                 /* wrap rather than shove the Reset button */
  }
  #ms-status[data-state='lost'] { color: var(--color-error); }
  #ms-status[data-state='win'] { color: var(--color-text); font-weight: 600; }
  .ms-help {
    margin: var(--space-3) auto 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    text-align: center;
    /* One line of this is wider than the 9-wide grid, and since .minesweeper
       is inline-block it would stretch the card past the board and leave dead
       space on the right. Capping under the grid's narrowest width keeps the
       card hugging the board; the text wraps instead. */
    max-width: 32ch;
    text-wrap: balance;
  }
  #ms-reset {
    flex-shrink: 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  #ms-reset:hover {
    border-color: var(--color-accent);
  }
  #ms-reset:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
<script>
  import {
    createBoard, reveal, toggleFlag, checkWin, MS_ROWS, MS_COLS, MS_MINES,
    type MinesweeperBoard, type MinesweeperCell,
  } from '../lib/minesweeper/engine';

  const grid = document.getElementById('ms-grid')!;
  const status = document.getElementById('ms-status')!;
  const resetBtn = document.getElementById('ms-reset')!;

  let board: MinesweeperBoard = createBoard();
  let gameOver = false;
  let focusIndex = 0;
  let longPressTimer: number | undefined;
  // Long-press bookkeeping: `longPressed` marks that the 500ms timer already
  // flagged this touch (so its synthetic click must be swallowed); `lastTouchAt`
  // lets the contextmenu handler tell a touch long-press menu (already flagged
  // by the timer) apart from a real mouse right-click.
  let longPressed = false;
  let lastTouchAt = 0;

  // Inline SVGs, not emoji: the old 💣/🚩 literals render as tofu boxes on any
  // system without a color emoji font (some Linux desktops, minimal headless
  // environments), and their presentation varies by platform even when they do
  // render. currentColor keeps them theme-aware; the flag picks up the cell's
  // error-red via the data-flagged color rule in the styles. aria-hidden —
  // describeCell() already carries the state to assistive tech.
  const SVG_FLAG =
    '<svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false">' +
    '<path d="M4.5 2v12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>' +
    '<path d="M4.5 2.6h6.8l-2.4 2.7 2.4 2.7H4.5z" fill="currentColor"/></svg>';
  const SVG_MINE =
    '<svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false">' +
    '<path d="M8 1.5v2.6M8 11.9v2.6M1.5 8h2.6M11.9 8h2.6M3.4 3.4l1.8 1.8M10.8 10.8l1.8 1.8M12.6 3.4l-1.8 1.8M5.2 10.8l-1.8 1.8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>' +
    '<circle cx="8" cy="8" r="3.6" fill="currentColor"/></svg>';

  // Returned as HTML and assigned via innerHTML below — numbers are plain text
  // either way, and the only markup these two constants produce is the SVGs.
  function cellContent(cell: MinesweeperCell): string {
    if (cell.flagged) return SVG_FLAG;
    if (!cell.revealed) return '';
    if (cell.mine) return SVG_MINE;
    return cell.adjacent > 0 ? String(cell.adjacent) : '';
  }

  // Positional context in every label: without it a screen reader announces
  // 81 identical "Hidden cell"s with no way to build a mental map of the grid.
  function describeCell(cell: MinesweeperCell, r: number, c: number): string {
    const pos = `Row ${r + 1}, column ${c + 1}`;
    if (cell.flagged) return `${pos}, flagged`;
    if (!cell.revealed) return `${pos}, hidden`;
    if (cell.mine) return `${pos}, mine`;
    return cell.adjacent > 0 ? `${pos}, ${cell.adjacent} adjacent mines` : `${pos}, empty`;
  }

  // Cells now live one level deeper than grid.children (grid > row > cell,
  // per valid ARIA grid/row/gridcell structure), so index into the
  // flattened cell list rather than grid.children directly.
  function getCell(index: number): HTMLElement | undefined {
    return grid.querySelectorAll('[role="gridcell"]')[index] as HTMLElement | undefined;
  }

  function createCellButton(cell: MinesweeperCell, r: number, c: number): HTMLButtonElement {
    const index = r * MS_COLS + c;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.tabIndex = index === focusIndex ? 0 : -1;
    btn.setAttribute('role', 'gridcell');
    btn.dataset.revealed = String(cell.revealed);
    if (cell.revealed && cell.mine) btn.dataset.mine = 'true';
    if (cell.flagged) btn.dataset.flagged = 'true';
    btn.setAttribute('aria-label', describeCell(cell, r, c));
    btn.innerHTML = cellContent(cell);
    btn.addEventListener('click', () => {
      // Keep the roving tabindex pointing at the cell actually played, or
      // Tab re-enters the grid at cell 0 rather than where the player is.
      focusIndex = index;
      onReveal(r, c);
    });
    btn.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      // Android Chrome ALSO fires contextmenu ~500ms into a long-press — the
      // same gesture the touch timer below already flags. Without this gate
      // both fire and the flag toggles twice (straight back to hidden). A
      // mouse right-click has no recent touchstart, so it flags normally.
      if (longPressed || Date.now() - lastTouchAt < 700) return;
      onFlag(r, c);
    });
    btn.addEventListener('touchstart', () => {
      lastTouchAt = Date.now();
      longPressed = false;
      longPressTimer = window.setTimeout(() => {
        longPressed = true;
        onFlag(r, c);
      }, 500);
    });
    // A drag means the visitor is scrolling/panning past the board, not
    // long-pressing a cell — cancel so a mid-scroll rest can't flag cells.
    btn.addEventListener('touchmove', () => window.clearTimeout(longPressTimer));
    btn.addEventListener('touchcancel', () => window.clearTimeout(longPressTimer));
    btn.addEventListener('touchend', (e) => {
      window.clearTimeout(longPressTimer);
      if (longPressed) {
        // The long-press already toggled the flag; swallow the synthetic click
        // the browser dispatches on release, or the just-unflagged cell
        // immediately reveals — mines included, detonated by the very gesture
        // meant to make it safe.
        e.preventDefault();
        longPressed = false;
      }
    });
    btn.addEventListener('keydown', (e) => onKey(e, r, c));
    return btn;
  }

  function render() {
    // innerHTML = '' destroys whatever had focus, so remember whether focus was
    // on the board before tearing it down and put it back afterwards. Doing it
    // here rather than at each call site is what fixes the mouse path: the
    // keyboard path used to refocus by hand after every render() and the mouse
    // path simply never did, dropping focus to <body> on every click.
    //
    // Gated on the grid ACTUALLY having had focus, which is what keeps this
    // from stealing it: the initial render at load happens with focus on
    // <body>, and Reset renders with focus on the Reset button — neither should
    // yank focus onto a cell.
    const hadFocus = grid.contains(document.activeElement);
    grid.innerHTML = '';
    board.forEach((row, r) => {
      const rowEl = document.createElement('div');
      rowEl.setAttribute('role', 'row');
      row.forEach((cell, c) => rowEl.appendChild(createCellButton(cell, r, c)));
      grid.appendChild(rowEl);
    });
    if (hadFocus) getCell(focusIndex)?.focus();
  }

  function onReveal(r: number, c: number) {
    if (gameOver) return;
    const result = reveal(board, r, c);
    board = result.board;
    if (result.exploded) {
      gameOver = true;
      status.textContent = 'You hit a mine.';
      status.dataset.state = 'lost';
    } else if (checkWin(board)) {
      gameOver = true;
      status.textContent = 'You cleared the board!';
      status.dataset.state = 'win';
    }
    render();
  }

  function onFlag(r: number, c: number) {
    if (gameOver) return;
    board = toggleFlag(board, r, c);
    render();
  }

  function onKey(e: KeyboardEvent, r: number, c: number) {
    const deltas: Record<string, [number, number]> = {
      ArrowUp: [-1, 0], ArrowDown: [1, 0], ArrowLeft: [0, -1], ArrowRight: [0, 1],
    };
    if (e.key in deltas) {
      e.preventDefault();
      const [dr, dc] = deltas[e.key];
      const nr = Math.min(Math.max(r + dr, 0), MS_ROWS - 1);
      const nc = Math.min(Math.max(c + dc, 0), MS_COLS - 1);
      focusIndex = nr * MS_COLS + nc;
      render();
    } else if (e.key === 'Enter') {
      // preventDefault stops the browser's own Enter-on-button default
      // action (a synthetic click) from firing after onReveal already
      // ran, which would otherwise call onReveal a second time.
      e.preventDefault();
      onReveal(r, c);
    } else if (e.key === ' ') {
      e.preventDefault();
      onFlag(r, c);
    }
    // No refocusing here any more: render() restores focus itself, for the
    // mouse as well as the keyboard. Three hand-written copies of that step
    // were what let the mouse path quietly go without one.
  }

  resetBtn.addEventListener('click', () => {
    board = createBoard();
    gameOver = false;
    focusIndex = 0;
    status.textContent = `Mines: ${MS_MINES}`;
    delete status.dataset.state;
    render();
  });

  render();
</script>
