---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <p class="meta">&copy; {year} John Ng</p>
  <div class="footer-right">
    <div class="social-links">
      <a href="https://www.linkedin.com/in/johnn05/" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
      </a>
      <a href="https://github.com/JohnN05" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2.1c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.24 2.75.12 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/></svg>
      </a>
    </div>
    <div class="footer-capybara" aria-hidden="true">
      <span class="capybara-caption">
        <span class="caption-line caption-line-1">you found me :D</span>
        <span class="caption-line caption-line-2">thanks for checking out my website :)</span>
      </span>
      <img src="/capybara-footer.webp" alt="" width="237" height="126" class="capybara-img" />
    </div>
  </div>
</footer>
<style>
  .site-footer {
    /* position+z-index (higher than index.astro's .seam, at z-index:1) so
       the footer's own content always paints above the blurred wash-fade
       band that bleeds ~5rem into this element's top on Home — otherwise
       the capybara caption text, which has no z-index of its own and so
       stacks at the footer's ambient level, renders underneath the seam's
       opaque gradient instead of on top of it. */
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    row-gap: var(--space-4);
    padding: var(--space-6) var(--space-5);
    border-top: 1px solid var(--line);
  }
  .footer-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .social-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .social-links a {
    color: var(--color-text);
  }

  .footer-capybara {
    position: relative;
    display: block;
    line-height: 0;
  }
  .capybara-img {
    display: block;
    height: 20px;
    width: auto;
  }

  .capybara-caption {
    position: absolute;
    right: 29%;
    bottom: calc(100% + var(--space-2));
    display: grid;
    width: max-content;
    max-width: min(50vw, 200px);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-align: right;
    line-height: 1.4;
  }
  .caption-line {
    grid-area: 1 / 1;
    opacity: 0;
  }

  .footer-capybara:hover .caption-line-1 {
    animation: capybara-line-1 4s ease forwards;
  }
  .footer-capybara:hover .caption-line-2 {
    animation: capybara-line-2 4s ease forwards;
  }

  @keyframes capybara-line-1 {
    0% { opacity: 0; }
    10% { opacity: 1; }
    45% { opacity: 1; }
    55% { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes capybara-line-2 {
    0% { opacity: 0; }
    55% { opacity: 0; }
    65% { opacity: 1; }
    100% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-capybara:hover .caption-line-1 {
      animation: none;
      opacity: 1;
    }
    .footer-capybara:hover .caption-line-2 {
      animation: none;
      opacity: 0;
    }
  }

  @media (max-width: 480px) {
    .capybara-caption {
      max-width: 40vw;
    }
  }
</style>
