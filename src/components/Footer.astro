<style>
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--color-text-secondary);
  }
  .social-links {
    display: flex;
    gap: 1rem;
  }
  .social-links a {
    color: var(--color-text);
  }
</style>
